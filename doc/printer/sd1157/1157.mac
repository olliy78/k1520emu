isiote:	push	af		; int. sio-sendebuffer leer
	ld	a,28h		; reset sender int. pending
	out	(v24c),a
	out	(ifssc),a
	ld	a,(ix+27h)	; sendesteuerregister in akku
	or	a
	jr	z,ist4		; sendesteuerregister =0
	cp	0e0h
	jr	z,ist6		; "csi" senden
	cp	0a0h
	jr	z,ist7		; abfrage druckertype
	cp	60h
	jr	z,ist12		; "da" senden
	cp	0c0h
	jr	z,ist6		; "csi" senden
	cp	80h
	jr	z,ist13		; zustandsabfrage
	ld	a,'n'
ist1:	out	(v24d),a	; ausgeben
	out	(ifssd),a
ist2:	res	6,(ix+27h)	; bit 6 im ssr = 0
	res	0,(ix+8)	; mb sfg=0
ist3:	pop	af
	ei
	reti
;
ist4:	in	a,(06fh)	; switch-pack 3
	bit	3,a
	jr	z,ist5		; s hdupl=0
	ld	a,5
	out	(v24c),a
	ld	a,0a8h		; 105 inaktiv
	out	(v24c),a
ist5:	set	0,(ix+8)	; mb sfg=1
	jr	ist3
;
ist6:	ld	a,'['		; "csi" in akku
	jr	ist1
;
ist7:	in	a,(0bch)	; 8212-system
	bit	2,a		; ebd
	jr	z,ist10		; 2-bahniger drucker
	bit	3,a		; bda
	jr	nz,ist11	; breite druckerausfuehrung
	ld	a,'4'		; druckerkennzeichnung senden
ist8:	out	(v24d),a
	out	(ifssd),a
ist9:	set	6,(ix+27h)	; sendesteuerregister
	res	7,(ix+27h)	; aktualisieren
	jr	ist3
;
ist10:	ld	a,'6'		; druckerkennzeichnung senden
	jr	ist8
;
ist11:	ld	a,'5'		; druckerkennzeichnung senden
	jr	ist8
;
ist12:	ld	a,'c'		; "da" in akku
	ld	(ix+27h),0	; sendesteuerregister loeschen
	jr	ist1
;
ist13:	ld	a,(ix+0bh)
	or	a
	jr	z,ist15		; modifiziertes zustandsregister=00
	bit	1,a
	jr	nz,ist16	; uebertragungsfehler
	bit	2,a
	jr	nz,ist20	; papierende
	bit	3,a
	jr	nz,ist19	; havarie
	ld	a,'4'		; "operationsfehler" senden
	out	(v24d),a
	out	(ifssd),a
	res	2,(ix+4)	; mb fof=0
	res	4,(ix+0bh)	; mzsr4=0
ist14:	ld	a,(ix+0ah)	; zustandsregister
	and	0e6h		; maskiert
	ld	(ix+0ah),a	; loeschen
	jr	ist9
;
ist15:	ld	a,'0'		; nullstatus senden
	jr	ist8
;
ist16:	ld	a,'1'		; uebertragungsfehler senden
	out	(v24d),a
	out	(ifssd),a
	res	1,(ix+0bh)	; mb uef=0
	jr	ist18
;
ist17:	ld	a,'2'		; papierende senden
	out	(v24d),a
	out	(ifssd),a
ist18:	ld	a,(ix+0bh)
	or	a
	jr	z,ist14		; modifiziertes zustandsregister =00
	jp	ist2
;
ist19:	ld	a,'3'		; "hv" senden
	out	(v24d),a
	out	(ifssd),a
	res	3,(ix+0bh)	; mb hv =0
	jr	ist18
;
ist20:	res	2,(ix+0bh)	; mzsr2=0
	in	a,(0bch)	; 8212-system
	bit	0,a		; /pe
	jr	z,ist17		; pe=1
	res	2,(ix+0ah)	; zmb pe=0
	res	5,(ix+7)	; mb ape=0
	jr	ist13
