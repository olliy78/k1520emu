; Interrupt linker Rand, Papiervorschub 1
;
m098d:	push	af
	in	a,(p1ad)
	bit	2,a		; xpfg1
	jp	nz,pt00		; int pzs1 (xpfg1=1)
	exx
	bit	6,(ix+5)	; mb syn
	jr	nz,m09a1	; mb syn=1
	ld	a,c
	cp	7
	jr	z,m09a7		; kpz=07
m09a1:	ld	bc,307h		; 7 in kpz, drspz=3
	ld	h,6		; 6 in spz
m09a7:	in	a,(p2ad)
	bit	5,a		; lauf
	jr	z,m09c9		; lauf=0
	in	a,(p2ad)
	bit	4,a		; vw
	jr	nz,m09bd	; vw=1
m09b3:	bit	3,(ix+5)
	jp	nz,m09f8	; mb asl=1
	jp	nmi		; havarie
m09bd:	bit	0,(ix+7)
	jr	nz,m09f8	; mb smrf=1
	jr	m09c9
;
m09c5:	ld	(ix+0eh),7	; 07 in tabz
m09c9:	exx
	pop	af
	ei
	reti
;
; Interrupt rechter Rand, Papiervorschub 2
;
m09ce:	push	af
	in	a,(p1bd)
	bit	2,a		; xpfg2
	jp	nz,pt50		; int pzs2 (xpfg2=1)
	exx
	in	a,(0bch)	; 8212-system
	bit	3,a		; bda
	ld	a,c
	jr	z,m09f0		; bda=0 schmaler drucker
	cp	220		; ;
	jr	z,m09e4		; ;kpz=220
	ld	c,220		; 220 in kpz
m09e4:	in	a,(p2ad)
	bit	5,a		; lauf
	jr	z,m09c9		; lauf=0
	bit	4,a		; vw
	jr	z,m09bd		; vw=0
	jr	m09b3		; vw=1
;
m09f0:	cp	142		; ;
	jr	z,m09e4		; ;kpz=142
	ld	c,142		; 142 in kpz
	jr	m09e4
;
m09f8:	push	hl
	push	de
	ld	d,0
	ld	h,d
	ld	e,8
	ld	l,(ix+0eh)	; tabz in l-reg.
	cp	a
	sbc	hl,de		; tabz-08
	pop	de
	pop	hl
	jp	m,m09c9		; tabz<7
	jp	m09c5
;
m0a0d:	bit	3,(ix+4)	; beg up zspu
	jr	z,m0a2d		; mb zspl2=0
	res	6,(ix+1)	; mb at2=0
	res	4,(ix+1)	; mb et2=0
	res	3,(ix+4)	; mb zspl2=0
	bit	7,(ix+1)
	jr	z,m0a3f		; mb at1=0
m0a25:	ld	hl,zspei2	; st-adr.zsp2
	ld	(ix+29h),32h	; ztsw2-gst
	ret
;
m0a2d:	res	7,(ix+1)	; mb at1=0
	res	5,(ix+1)	; mb et1=0
	set	3,(ix+4)	; mb zspl2=1
	bit	6,(ix+1)
	jr	z,m0a25		; mb at2=0
m0a3f:	ld	hl,zspei1	; st-adr.zsp1
	ld	(ix+28h),28h	; ztsw1-gst
	ret
;
; Interrupt Controlport PIO Interface
;
iparc:	push	af		;; int. par. interface
	in	a,(p2bd)
	bit	3,a		;; /tf
	jp	z,iparc2	;; techn. fehler
	bit	5,(ix+7)	;; mb ape
	jp	nz,iparc2	;; mb ape=1
	bit	6,a		;; ifg
	jp	z,iparc1	;; ifg=0
	in	a,(p3bd)
	bit	1,a		;; taste online
	jr	nz,iparc1	;; offline
	in	a,(p2bd)
	set	7,a		;; ac-i=aktiv
	out	(p2bd),a
iparc1:	pop	af
	ei
	reti
;
iparc2:	in	a,(p2ad)
	res	1,a		;; a0-i=inaktiv onlinelampe
	out	(p2ad),a
	in	a,(p2bd)
	set	6,a		;; ifg=1
	out	(p2bd),a
	jr	iparc1
;
; Interrupt von CTC1
;
m0a79:	dec	(ix+10h)	;; kberz-1
	jr	m0a86
;
m0a7e:	res	5,(ix+5)	;; mb kber=0
m0a82:	ld	a,13h		;; abbruch
	out	(ctc1),a
m0a86:	pop	af
	ei
	reti
;
ictc1:	push	af		;; int kas/kber sys-ctc-kanal 1 interrupt
	bit	1,(ix+6)
	jr	nz,ictc11	;; mb zkst=1
	ld	a,(ix+10h)	;; kberz in akku
	or	a
	jr	nz,m0a79	;; kberz>0
	bit	4,(ix+5)
	jr	z,m0a7e		;; mb bkas=0
	res	4,(ix+5)	;; mb bkas=0
	jr	m0a82
;
ictc11:	ld	a,(ix+13h)	;; zkz in akku
	or	a
	jp	nz,m0b1f	;; zkz>0
	ld	a,(ix+6)	;; mbyte 6 in akku
	bit	6,a
	jp	nz,m0d70	;; mb zkip=1
	bit	7,a
	jp	nz,m0b09	;; mb zk due-e=1
	bit	3,a
	jp	nz,m0b30	;; mb zkpv=1
	bit	5,a
	jp	nz,m0b45	;; mb zkapv1=1
	bit	4,a
	jr	nz,m0b10	;; mb zkapv2=2
	in	a,(p2bd)
	res	6,a		;; ifg=0
	out	(p2bd),a
	set	0,(ix+1)	;; mb hprw=1
	ld	(ix+6),4	;; mb zkdr=1
	call	ze00		;; up ze
	set	4,(ix+3)	;; mb zspv=1
	sub	a		;; 00 in a
	cp	(ix+32h)
	jr	nz,hp43		;; parl1#0
	cp	(ix+33h)
	jr	nz,hp43		;; parh1#0
	cp	(ix+53h)
	jr	nz,hp43		;; parl2#0
	cp	(ix+54h)
	jr	nz,hp43		;; parh2#0
	cp	(ix+0eeh)
	jr	nz,hp43		;; zfar11#0
	cp	(ix+0f7h)
	jr	nz,hp43		;; zfar21#0
	ld	a,(ix+1)	;; mbyte 1 in akku
	bit	7,a
	jr	z,m0b15		;; mb at1=0
	bit	6,a
	jr	z,m0b19		;; mb at1=1,mb at2=0
ictc12:	jp	m0a7e		;; mb at1,2=1
;
m0b09:	set	0,(ix+4)	; mb due-e=1
	jp	m0b3b
;
m0b10:	call	hp91		; up apv2
	jr	ictc12
;
m0b15:	bit	6,a
	jr	z,ictc12	; mb at1,2=0
m0b19:	set	0,(ix+3)	; mb pvoz=1
	jr	ictc12
;
m0b1f:	dec	(ix+13h)	; zkz-1
	pop	af
	ei
	reti
;
hp43:	set	0,(ix+3)	; mb pvoz=1
	set	0,(ix+5)	; mb parv=1
	jr	ictc12
;
m0b30:	call	if47		; up regversch.
	di
	ld	ix,mbytes+3
	call	if47		; up reg-versch. (pzw in paf)
m0b3b:	ld	(ix+6),0	; m-byte 6=00
	res	0,(ix+3)	; mb pv0z=0
	jr	ictc12
;
m0b45:	in	a,(p2bd)
	res	2,a		; kas=0 kopfanschw.
	res	4,a		; fma=0 farbbandmotor
	out	(p2bd),a
	bit	0,(ix+2)	; mb slz
	jr	z,m0b6c		; mb slz=0
m0b53:	ld	(ix+38h),18h	; pafl1=24
	in	a,(0bch)	; 8212-system
	bit	2,a		; einbahn dr.
	jr	nz,m0b61	; ebd=1
	ld	(ix+59h),18h	; pafl2=24
m0b61:	set	1,(ix+5)	; mb apv=1
	bit	6,(ix+5)	; mb syn
	jp	nz,hp04		; mb syn=1
m0b6c:	ld	(ix+6),0	; m-byte zk=00
	jr	ictc12
;
hp91:	push	af		; up apv2 (formularrueckzug in druckposition
	ld	(ix+6),0	; m-byte zk=00
	res	1,(ix+5)	; mb apv=0
	ld	(ix+38h),18h	; pafl1=24
	in	a,(0bch)	; 8212-system
	bit	2,a		; einbahn dr.
	jr	nz,m0b89	; ebd=1
	ld	(ix+59h),18h	; pafl2=24
m0b89:	set	1,(ix+3ah)	; mb rpr1=1
	set	1,(ix+5bh)	; mb rpr2=1
	pop	af
	ret
;
m0b93:	in	a,(p3bd)
	bit	0,a		; ser/par
	jr	nz,m0bbf	; kein ser.interface
	bit	5,(ix+8)
	jp	nz,m0cf6	; mb ipv=1
	bit	6,(ix+8)
	jr	z,m0bcc		; mb ipnl=0
	bit	1,(ix+6)
	jr	nz,m0bcc	; mb zkst=1
	ld	a,0b7h		; ksw zk
	out	(ctc1),a
	ld	a,0ffh
	out	(ctc1),a
	ld	(ix+13h),8	; zkz=08
	ld	(ix+6),42h	; mb zkst und zkip=1
	jp	hp04
;
m0bbf:	in	a,(p2bd)
	bit	3,a		; /tf
	jp	nz,m0646	; kein techn. fehler
	jp	hp04		; techn. fehler
;
m0bc9:	jp	m0c78
;
m0bcc:	bit	1,(ix+8)
	jr	nz,m0bc9	; mb dc1=1
	bit	1,(ix+0ah)
	jr	nz,m0c04	; zmb hv=1
	in	a,(p2ad)
	bit	7,a		; a3-i
	jr	nz,m0bc9	; a3-i=aktiv
	sub	a		; ------------------
	cp	(ix+32h)
	jr	nz,m0bc9
	cp	(ix+33h)
	jr	nz,m0bc9	; par-register # 0
	cp	(ix+53h)
	jr	nz,m0bc9
	cp	(ix+54h)
	jr	nz,m0bc9	; --------------------
	cp	(ix+0eeh)
	jr	nz,m0bc9	; zf-register # 0
	cp	(ix+0f7h)
	jr	nz,m0bc9	; --------------------
	in	a,(p3bd)
	bit	1,a		; taste online
	jp	nz,m0c78	; offline
m0c04:	ld	a,3		; empfaengerfreigabe
	out	(ifssc),a
	ld	a,41h
	out	(ifssc),a
	bit	0,(ix+8)
	jp	z,hp04		; mb sfg=0
	bit	4,(ix+8)
	jp	nz,m0cd2	; mb dc4=1
	in	a,(p3ad)
	bit	0,a
	jr	z,m0c8c		; ifss
m0c20:	bit	5,(ix+9)
	jr	nz,m0c43	; mb 108.2=1
	bit	3,(ix+9)
	jp	z,hp04		; mb fg108.2=0
	in	a,(06fh)	; switch-pack 3
	bit	3,a
	jr	z,m0c82		; duplex
	ld	a,5		; register 5
	out	(v24c),a
	ld	a,0a8h		; 108.2=aktiv,105=inaktiv
	out	(v24c),a
m0c3b:	set	5,(ix+9)	; mb 108.2=1
	res	3,(ix+9)	; mb fg108.2=0
m0c43:	in	a,(06fh)	; switch-pack 3
	bit	1,a
	jr	nz,m0c65	; s opr=1
	bit	4,a
	jr	z,m0c92		; s ext=0
	bit	4,(ix+9)
	jr	z,m0cc2		; mb ext=0
	ld	a,5		; register 5
	out	(v24c),a
	ld	a,0aah		; 105 aktiv
	out	(v24c),a
	bit	4,(ix+8)
	jr	nz,m0cac	; mb dc4=1
	ld	a,6		; sonst ACK senden
	out	(v24d),a
m0c65:	set	1,(ix+8)	; mb dc1=1
m0c69:	res	3,(ix+8)	; mb dc3=0
	push	hl
	ld	hl,37ffh	; grundstellung
	ld	(ipzf),hl	; in ipzf
	ld	(ipzl),hl	; und ipzl schreiben
	pop	hl
m0c78:	bit	1,(ix+0ah)
	jp	nz,hp04		; zmb hv=1
	jp	m0646
;
m0c82:	ld	a,5
	out	(v24c),a
	ld	a,0aah		; 108.2 und 105 aktiv
	out	(v24c),a
	jr	m0c3b
;
m0c8c:	ld	a,dc1		; dc1 senden
	out	(ifssd),a
	jr	m0c65
;
m0c92:	ld	a,5		; reg. 5
	out	(v24c),a
	ld	a,0aah		; 105 aktiv
	out	(v24c),a
	bit	4,(ix+8)
	jr	nz,sdc4		; mb dc4=1
	ld	a,dc1		; dc1 senden
	out	(v24d),a
	jr	m0c65
;
sdc4:	ld	a,dc4		; dc4 senden
	out	(v24d),a
	jr	m0c65
;
m0cac:	ld	a,15h		; nak senden
	out	(v24d),a
	ld	a,(ix+0ah)	; zustandsregister
	and	66h		; maskiert
	ld	(ix+0ah),a	; loeschen
	ld	a,(ix+0bh)	; mod.zustandsregister
	and	0ch		; maskiert
	ld	(ix+0bh),a	; loeschen
	jr	m0c65
;
m0cc2:	in	a,(06fh)	; switch-pack 3
	bit	3,a
	jr	z,m0c65		; duplex
	ld	a,5
	out	(v24c),a
	ld	a,0a8h		; 105 inaktiv
	out	(v24c),a
	jr	m0c65
;
m0cd2:	res	4,(ix+8)	;- dc4 bit ruecksetzen
	in	a,(p3ad)
	bit	0,a
	jr	nz,m0cde	; v24
	ld	a,dc4		; dc4 senden
	out	(ifssd),a
	jr	m0c65
;
m0cde:	in	a,(06fh)	; switch-pack 3
	bit	1,a
	jp	z,m0c20		; s opr=0
	bit	5,(ix+7)
	jp	nz,m0c69	; mb ape=1
	bit	1,(ix+0ah)
	jp	z,m0c20		; mb hv=1
	jp	m0c69
;
; Zeichen aus Inputbuffer holen
;
m0cf6:	ld	a,(ix+31h)	; ipzl h-teil
	cp	(ix+2fh)	; ipzf h-teil
	jr	c,m0d06		; ipzl<ipzf
	ld	a,(ix+30h)	; ipzl l-teil
	cp	(ix+2eh)	; ipzf l-teil
	jr	nc,m0d3e	; ipzl=ipzf
m0d06:	bit	0,(ix+4)
	jr	z,m0d22		; mb due-e=0
	res	1,(ix+8)	; mb dc1=0
	inc	(ix+30h)	; ipzl l-teil+1
	jr	nz,m0d18	; ipzl#0
	inc	(ix+31h)	; ipzl h-teil+1
m0d18:	push	hl
	ld	hl,(ipzl)	; adresse fuer ipzl in hl
	ld	a,m		; ip-byte in akku
	pop	hl
	ei
	jp	if03		; Zeichen ausgeben
;
m0d22:	bit	1,(ix+6)
	jp	nz,hp04		; mb zkst=1
	ld	a,0b7h
	out	(ctc1),a
	ld	a,19h		; ctc-zeit=2,56ms
	out	(ctc1),a
	ld	a,(ix+0ech)	; zk-register
	ld	(ix+13h),a	; zkr in zkz
	ld	(ix+6),82h	; mb zkdue-e und mb zkst=1
	jp	hp04
;
m0d3e:	res	6,(ix+8)	; mb ipnl=0
	res	5,(ix+8)	; mb ipv=0
	res	0,(ix+4)	; mb due-e=0
	ld	a,3
	out	(ifssc),a
	ld	a,40h		; empfaengerfreigabe
	out	(ifssc),a
	ld	a,(ix+0ah)
	and	9fh
	or	a
	jr	nz,m0d62	; fehlerstatus
	bit	1,(ix+0bh)
	jp	z,m0646		; nullstatus
m0d62:	set	4,(ix+8)	; mb dc4=1
	bit	1,(ix+0ah)
	jp	nz,hp04		; zmb hv=1
	jp	m0646
;
	ds	30,0
;
m0d70:	in	a,(p3ad)
	bit	0,a
	jr	nz,m0d87	; s v24=1
	ld	a,dc3		; dc3 senden
	out	(ifssd),a
m0d7a:	ld	a,(ix+8)
	res	1,a		; mb dc1=0
	or	28h		; mb dc3=1,mb ipv=1
	ld	(ix+8),a
	jp	m0b3b
;
m0d87:	in	a,(06fh)	; switch-pack 3
	bit	1,a
	jr	nz,m0da3	; s opr=1
	bit	4,a
	jr	z,m0dbb		; s etx=0
	bit	3,a
	jr	nz,m0db1	; s hdupl=1
	ld	a,5
	out	(v24c),a
	ld	a,2ah		; 108.2 inaktiv
	out	(v24c),a
	res	5,(ix+9)	; mb 108.2=0
	jr	m0d7a
;
m0da3:	ld	a,5
	out	(v24c),a
	ld	a,28h		; 108.2 inaktiv
	out	(v24c),a
	res	5,(ix+9)	; mb 108.2=0
	jr	m0d7a
;
m0db1:	ld	a,5
	out	(v24c),a
	ld	a,0aah		; 105 aktiv
	out	(v24c),a
	jr	m0d7a
;
m0dbb:	ld	a,5
	out	(v24c),a
	ld	a,0aah		; 105 aktiv
	out	(v24c),a
	ld	a,dc3		; dc3 senden
	out	(v24d),a
	jr	m0d7a
;
; SIO Daten Interrupt
;
serinp:	push	af		; int ipf(fehlerfreies datenint.)
	res	4,(ix+9)	; mb etx=0
	ld	a,(ix+2fh)	; ipzf h-teil in akku
	cp	3bh
	jr	c,seri1		; ipzf<absoluter endwert
	ld	a,(ix+2eh)	; ipzf l-teil in akku
	cp	0ffh
	jr	nc,seri10	; ipzf=absoluter endwert
seri1:	in	a,(p3ad)
	bit	0,a
	jr	nz,seri9	; s v24=1
	in	a,(ifssd)
seri2:	res	7,a		; 7-bit-code
	cp	2
	jr	z,seri3		; stx
	cp	3
	jr	z,seri7		; etx
	inc	(ix+2eh)	; ipzf l-teil +1
	jr	nz,seri4	; ipzf l-teil#0
	inc	(ix+2fh)	; ipzf h-teil+1
seri4:	push	hl
	ld	hl,(ipzf)	; adresse fuer ipzf in hl
	ld	m,a		; datenbyte in ip
	pop	hl
	set	6,(ix+8)	; mb ipnl=1
	bit	1,(ix+6)
	jr	z,seri3		; mb zkst=0
	ld	a,13h		; abbruch
	out	(ctc1),a
	ld	(ix+6),0	; m-byte zk=00
seri3:	ld	a,(ix+2fh)	; ipzf h-teil
	cp	3bh
	jr	c,seri8		; ipzf<endwert mit vorhalt
	ld	a,(ix+2eh)	; ipzf l-teil
	cp	0f5h
	jr	c,seri8		; ipzf<endwert mit vorhalt
seri5:	set	5,(ix+8)	; mb ipv=1
	bit	3,(ix+8)
	jr	nz,seri6	; mb dc3=1
	set	3,(ix+8)	; mb dc3=1
	res	1,(ix+8)	; mb dc1=0
	in	a,(p3ad)
	bit	0,a
	jr	nz,seri14	; s v24=1
	ld	a,dc3		; dc3 senden
	out	(ifssd),a
seri6:	pop	af
	ei
	reti
;
seri7:	set	4,(ix+9)	; mb etx=1
	jr	seri5
;
seri8:	in	a,(p3bd)
	bit	1,a		; taste online
	jr	z,seri6		; online
	jr	seri5		; offline
;
seri9:	in	a,(v24d)
	jr	seri2
;
seri10:	set	7,(ix+8)	; mb ipuel=1
	set	1,(ix+0bh)	; mzmb uef=1
	in	a,(p3ad)
	bit	0,a
	jr	nz,seri13	; s v24=1
	in	a,(ifssd)
seri11:	set	4,(ix+8)	; mb dc4=1
seri12:	ld	a,5
	out	(v24c),a
	ld	a,28h		; 108.2 u.105 inaktiv
	out	(v24c),a
	res	5,(ix+9)	; mb 108.2=0
	jr	seri6
;
seri13:	in	a,(v24d)
	jr	seri11
;
seri14:	in	a,(06fh)	; switch-pack 3
	bit	1,a
	jr	nz,seri12	; s opr=1
	bit	4,a
	jr	nz,seri15	; s etx=1
	ld	a,5
	out	(v24c),a
	ld	a,0aah		; 108.2 u.105 aktiv
	out	(v24c),a
	ld	a,dc3		; dc3 senden
	out	(v24d),a
	jp	seri6
;
seri15:	bit	4,(ix+9)
	jp	nz,seri6	; mb etx=1
	in	a,(06fh)	; switch-pack 3
	bit	3,a
	jr	nz,seri16	; s hdupl=1
	ld	a,5
	out	(v24c),a
	ld	a,2ah		; 108.2 inaktiv
	out	(v24c),a
	res	5,(ix+9)	; mb 108.2=0
	jp	seri6
;
seri16:	ld	a,5
	out	(v24c),a
	ld	a,0aah		; 105 aktiv
	out	(v24c),a
	jp	seri6
;
; SIO Fehlerinterrupt
;
errint:	push	af		; int ipff (fehlerinterrupt)
	in	a,(p3ad)
	bit	0,a
	ld	a,30h		; kommando 6 senden
	jp	nz,erint5	; s v24=1
	out	(ifssc),a	; bei ifss
erint1:	ld	a,(ix+2fh)	; ipzf h-teil
	cp	3bh
	jr	c,erint2	; ipzf<absoluter endwert
	ld	a,(ix+2eh)	; ipzf l-teil
	cp	0ffh
	jr	nc,seri10	; ipzf=absoluter endwert
erint2:	set	1,(ix+0bh)	; mzmb uef=1
	in	a,(p3ad)
	bit	0,a
	jr	nz,erint4	; s v24=1
	in	a,(ifssd)	; fehlerhaftes Zeichen lesen
erint3:	ld	a,'?'		; "?" in akku
	jp	seri2
;
erint4:	in	a,(v24d)
	jr	erint3
;
erint5:	out	(v24c),a	; kommando 6 senden
	jp	erint1
;
; SIO Extern Status Interrupt
;
serest:	push	af		; beg. interrupt ext.status
	ld	a,10h		; kommando 2 senden
	out	(v24c),a
	xor	a
	out	(v24c),a
	in	a,(v24c)
	bit	7,a
	jr	nz,serex2	; break
	bit	4,a
	jr	nz,serex1	; 107 inaktiv
	set	6,(ix+9)	; mb 107=1
	jp	seri6
;
serex1:	bit	6,(ix+9)
	jp	z,seri6		; mb 107=0
	set	3,(ix+9)	; mb fg108.2=1
	res	6,(ix+9)	; mb 107=0
	jp	seri6
;
serex2:	set	7,(ix+9)	; mb break=1
	jp	seri5
;
; Self-Test Mode
;
hpt0:	bit	7,(ix+7)
	jp	nz,sy00		; mb teste=1
	push	hl
	ld	hl,konst1	; anfangsadresse
	ld	(ix+25h),h	; der konstantentabelle
	ld	(ix+24h),l	; abspeichern
	pop	hl
hpt1:	push	hl
	ld	h,(ix+25h)	; aspth
	bit	7,h
	jr	nz,hpt7		; bit 7h=1
	ld	l,(ix+24h)	; asptl
	ld	a,m		; tbyte in a
	cp	0ffh
	jr	z,hpt3		; tbyte =ff ende teststring
	bit	7,a
	jr	nz,hpt10	; bit 7=1
	inc	hl		; neuen
hpt2:	ld	(ix+25h),h	; aspt-wert
	ld	(ix+24h),l	; abspeichern
	pop	hl
	jr	hpt5
;
hpt3:	pop	hl		; ende zyklus
	in	a,(p3bd)
	bit	6,a		; taste test
	jr	z,hpt6		; ttest=1
hpt4:	bit	7,(ix+7)
	jp	nz,m0646	; mb teste =1
	set	7,(ix+7)	; mb teste =1
	in	a,(0bch)	; 8212-system
	bit	2,a		; ebd
	jr	nz,formf1	; ebd=1
	ld	a,13h		; bef.ff2 in a
hpt5:	jp	if03		; ausgeben
;
hpt6:	in	a,(p3bd)
	bit	1,a		; taste online
	jr	z,hpt4		; online
	bit	5,(ix+7)
	call	nz,hpv2		; mb ape=1
	jr	hpt0
;
formf1:	ld	a,0ch		; bef.ff1 in a
	jr	hpt5
;
hpt7:	ld	a,(ix+24h)
	bit	3,(ix+1)
	jr	nz,hpt8		; mb sof=1
	cp	'_'
	jr	z,hpt11		; tbyte=5f
	cp	'~'
	jr	z,hpt12		; tbyte=7e
	jr	hpt10
;
hpt8:	cp	'?'
	jr	z,hpt13
	cp	'~'
	jr	nz,hpt10
hpt9:	ld	hl,m336a
	jr	hpt2
;
hpt10:	res	7,a
	set	7,h
	ld	l,a		; byte speichern
	inc	l
	jr	hpt2
;
hpt11:	ld	hl,m335f	; aspt laden
	jr	hpt2
;
hpt12:	ld	hl,ezg2		; ende 2. zeicheng.
	ld	a,m
	or	a
	ld	a,7eh
	jr	nz,hpt9		; 2.zg nicht bestueckt
	ld	hl,m3363	; aspt laden
	jr	hpt2
;
hpt13:	ld	hl,m3366	; aspt laden
	jr	hpt2
;
; Interrupt von PIO Interface
;
ipard:	ei			; datenuebernahme von par. interface
	in	a,(p2bd)
	bit	3,a		; /tf
	jr	z,m1009		; techn. fehler
	res	7,a		; ac-i=inaktiv
	out	(p2bd),a
	in	a,(p3ad)	; daten holen
if03:	push	de		; Drucken Zeichen in A
	ld	e,a		; in e-register
	bit	1,(ix+6)	; mb zkst
	jr	z,m0fdb		; mb zkst=0
	ld	a,13h		; ksw f.
	out	(ctc1),a
	ld	(ix+6),0	; mbyte zk=00
m0fdb:	res	7,e		; 7-bit code
	ld	a,e
	bit	7,(ix+2)
	jr	z,befa1		; mb esc=0
	bit	6,(ix+2)
	jp	z,m1101		; mb csi=0
	bit	4,(ix+2)
	jp	nz,nxtpar	; mb par1=1
	and	70h		; zeichen der
	cp	30h		; 3.spalte ?
	jr	nz,beferr	; ub
	set	4,(ix+2)	; mb par1=1
	ld	a,e
	and	0fh		; h-tetr.loesch.
	ld	(ix+26h),a	; parameter in parameter-register
	sub	0ah
	jr	nc,beferr	; ub
befnop:	jp	befe0
;
m1009:	set	1,(ix+0ah)	; zmb hv=1
	jr	befnop		; zust.meldung
;
befesc:	set	7,(ix+2)	; mb esc=1
	jr	befnop
;
befa1:	and	01100000b
	or	a
	ld	a,e
	jp	nz,nobef	; druckbares Zeichen
	or	a
	jr	z,befnop	; nop
	cp	esc
	jr	z,befesc	; esc
	cp	0eh
	jr	z,befso		; so
	cp	0fh
	jp	z,befsi		; si
	cp	0dh
	jp	z,befcr		; cr
	cp	8
	jr	z,befbs		; bs
	cp	9
	jp	z,befht		; ht
	cp	0ah
	jp	z,beflf1	; lf1
	cp	0bh
	jp	z,befvt1	; vt1
	cp	0ch
	jp	z,befff1	; ff1
	in	a,(0bch)	; 8212-system
	bit	2,a		; einbahndrucker
	jr	nz,beferr	; unerl. bef. bei ebd
	ld	a,e		; befehle fuer 2. druckbahn
	cp	11h
	jp	z,beflf2	; lf2
	cp	12h
	jp	z,befvt2	; vt2
	cp	13h
	jp	z,befff2	; ff2
beferr:	set	4,(ix+0ah)	; zmb ub=1
	ld	a,(ix+2)
	and	7		; mb esc,csi,zwz,par1,par2=0
	ld	(ix+2),a
befe1:	jp	befe0
;
befso:	push	bc
	ld	bc,ezg2		; ende zeichengenerator 2
	ld	a,(bc)
	or	a
	pop	bc
	jr	nz,beferr	; 2. zeicheng. nicht bestueckt
	jp	zg2on
;
befbs:	call	m1083		; up parameter
	jp	hprr		; hprr
;
m1083:	ld	(ix+26h),1	; 01 in parameter-register
	bit	1,(ix+1)
	ret	z		; mb bdrf=0
	inc	(ix+26h)	; parameter-register+1
	ret
;
m1090:	set	2,(ix+4)	; mb fof=1
	set	3,(ix+0ah)	; zmb fof=1
	jr	befe1		; zust.meldung
;
m109a:	set	0,(ix+1)	; mb hprw=1
	call	m14a5
	ld	(ix+0fh),0	; dpz=00
	res	2,(ix+4)	; mb fof=0
	ld	iy,tabmr	; tab-marken-register-grundstellung
	ret
;
befcr:	call	m109a		; up cr
	jr	befe1
;
befht:	push	de		; beg.ht-befehl
	push	hl		; abarbeitung
	ld	d,0
	ld	h,d
	ld	l,(ix+0fh)	; dpz in l
	ld	e,(iy)		; tabmr in e
	cp	a
	sbc	hl,de		; dpz-tabmr
	pop	hl
	pop	de
	jp	p,befht3	; dpz>tabmr
befht1:	call	m1330		; up lzbd
befht2:	push	de
	push	hl
	ld	d,0
	ld	h,d
	ld	l,(ix+0fh)	; dpz in l
	ld	e,(iy)		; tabmr in e
	cp	a
	sbc	hl,de		; dpz-tabmr
	pop	hl
	pop	de
	jr	z,befht4	; dpz=tabmr
	jp	m,befht1	; dpz<tabmr
befht3:	ld	(m2cc4),iy	; iy-reg abbild.
	ld	a,(m2cc4)	; l-teil in akku
	cp	0dfh
	jr	z,m1090		; ztabm=16
	inc	iy		; n.tabmr akt
	jr	befht2
;
befht4:	call	befht5		; up bdrhp
	inc	iy		; n.tabm akt.
	jr	m110a
;
befht5:	bit	7,(ix+3)	; up bdrhp
	ret	z		; mb bdrhp1=0
	inc	hl		; sazf+1
	ld	m,8ch		; bu in zsp
	res	7,(ix+3)	; mb bdrhp1=0
	ret
;
m1101:	cp	'['
	jp	nz,m1641	; 2-byte-befehl
	set	6,(ix+2)	; mb csi=1
m110a:	jp	befe0
;
nobef:	cp	' '
	jr	nz,nobef1	; kein space
	call	m1083		; up parameter
	jp	hprv		; hprv
;
m1117:	bit	6,(ix+1)
	jp	nz,m11ad	; mb at2=1
	set	6,(ix+1)	; mb at2=1
	inc	hl		; sazf+1
	ld	m,83h		; at in zsp
	ld	a,(ix+0fh)
	add	a,8		; dpz +08
	ld	(ix+15h),a	; kpat2
	inc	hl
	ld	(ix+1ch),l	; zspa2
	ld	(ix+1dh),h	; laden
	dec	hl
	jr	m118f
;
befdel:	in	a,(p2bd)
	bit	3,a		; /tf
	jr	z,m110a		; techn. fehler
	res	6,a		; ifg=0
	out	(p2bd),a
	set	4,(ix+7)	; mb del=1
	jr	m110a
;
nobef1:	cp	7fh
	jr	z,befdel	; delete
	in	a,(p2bd)
	bit	3,a		; /tf
	jr	z,m110a		; techn. fehler
	bit	5,(ix+7)	; mb ape
	jr	nz,m110a	; mb ape=1
	call	m13ab		; up fo
	bit	2,(ix+4)	; mb fof
	jr	nz,m110a	; mb fof=1
	in	a,(p2ad)
	set	7,a		; a3-i=aktiv
	out	(p2ad),a
	in	a,(p2bd)
	set	4,a		; fma=1 farbbandmotor
	out	(p2bd),a
	bit	4,(ix+4)	; mb zspf2
	jr	nz,m1117	; mb zspf2=1
	bit	7,(ix+1)	; mb at1
	jr	nz,m11ad	; mb at1=1
	set	7,(ix+1)	; mb at1=1
	inc	hl		; sazf+1
	ld	m,83h		; at in zsp
	ld	a,(ix+0fh)
	add	a,8		; dpz+8
	ld	(ix+14h),a	; kpat1
	inc	hl
	ld	(ix+1ah),l	; zspa1
	ld	(ix+1bh),h	; laden
	dec	hl
m118f:	call	if47		; up reg-versch.
	res	5,(ix+3)	; mb ze=0
	res	0,(ix+1)	; mb hprw=0
	bit	2,(ix+1)
	jp	z,m1256		; mb sdrf=0
	inc	hl
	ld	m,88h		; su in zsp
m11a4:	bit	3,(ix+1)
	jr	z,m11ad		; mb soe=0
	inc	hl
	ld	m,8eh		; cu in zsp
m11ad:	res	6,(ix+3)	; mb bdrhp2=0
	bit	2,(ix+2)
	jr	z,m121a		; mb sp=0
	res	2,(ix+2)	; mb sp=0
	ld	a,(ix+0dh)	; lsz in akku
	bit	7,a
	jr	nz,m11c7	; lsz>128
	sub	14h
	jp	m,m121a		; lsz<20
m11c7:	bit	1,(ix+2)
	jr	z,m11d4		; mb lzsdr=0
	res	1,(ix+2)	; mb lzsdr=0
	dec	(ix+0dh)	; slz-1
m11d4:	ld	l,(ix+22h)	; sp-adr in
	ld	h,(ix+23h)	; sazf
	inc	hl		; sazf+1
	ld	m,89h		; ht in zsp
	bit	1,(ix+1)
	jr	z,m11ea		; mb bdrf=0
	inc	hl		; sazf+1
	ld	m,8ch		; bu in zsp
	res	1,(ix+3)	; mb bu=0
m11ea:	bit	4,(ix+4)
	jr	nz,m1245	; mb zspf2=1
	push	hl
	ld	l,(ix+28h)	; lade lsz
	ld	h,2ch		; in akt
	ld	a,(ix+0dh)	; tabsw1
	ld	m,a
	inc	l		; ztsw1
	ld	(ix+28h),l	; akt
	pop	hl
m11ff:	bit	2,(ix+3)
	jr	z,m1208		; mb su=0
	inc	hl		; sazf+1
	ld	m,88h		; su in zsp
m1208:	bit	1,(ix+3)
	jr	z,m1211		; mb bu=0
	inc	hl
	ld	m,8ch		; bu in zsp
m1211:	bit	3,(ix+3)
	jr	z,m121a		; mb cu=0
	inc	hl
	ld	m,8eh		; cu in zsp
m121a:	ld	a,(ix+3)
	and	0f1h		; mb bu,su,cu=0
	ld	(ix+3),a
	ld	(ix+0dh),0	; lsz=00
	res	1,(ix+2)	; mb lzsdr=0
	inc	hl		; zeichen
	ld	m,e		; in zsp
	inc	(ix+0fh)	; dpz +1
	bit	2,(ix+1)
	jr	z,m1239		; mb sdrf=0
	set	1,(ix+2)	; mb lzsdr=1
m1239:	bit	1,(ix+1)
	jr	z,m1242		; mb bdrf=0
	inc	(ix+0fh)	; dpz+1
m1242:	jp	befe0
;
m1245:	push	hl		; -----
	ld	l,(ix+29h)	; lade lsz
	ld	h,2ch		; in akt.
	ld	a,(ix+0dh)	; tabsw 2
	ld	m,a		; --------
	inc	l		; ztsw 2
	ld	(ix+29h),l	; akt.
	pop	hl
	jr	m11ff
;
m1256:	bit	1,(ix+1)
	jr	z,m125f		; mb bdrf=0
	inc	hl
	ld	m,8ch		; bu in zsp
m125f:	jp	m11a4
;
if47:	ld	a,(ix+34h)	; up reg-versch.
	ld	(ix+37h),a	; --------------
	ld	a,(ix+33h)	; lade
	ld	(ix+36h),a
	ld	a,(ix+32h)	; pv-quell-
	ld	(ix+35h),a
	ld	a,(ix+55h)	; register
	ld	(ix+58h),a	; in
	and	1
	ld	(ix+55h),a
	ld	(ix+34h),a	; pv-ziel-
	ld	a,(ix+54h)
	ld	(ix+57h),a	; register
	ld	a,(ix+53h)
	ld	(ix+56h),a	; --------------
	ld	a,(ix+0eeh)	; ----------------
	ld	(ix+0f1h),a	; lade
	ld	a,(ix+0efh)
	ld	(ix+0f2h),a	; zf-quell-
	ld	a,(ix+0f0h)	; register
	ld	(ix+0f3h),a
	ld	a,(ix+0f7h)	; in
	ld	(ix+0fah),a
	ld	a,(ix+0f8h)	; zf-ziel-
	ld	(ix+0fbh),a	; register
	ld	a,(ix+0f9h)
	ld	(ix+0fch),a	; ----------------
	sub	a		; --------------
	ld	(ix+33h),a	; pv-quell-
	ld	(ix+32h),a	; register
	ld	(ix+54h),a	; loeschen
	ld	(ix+53h),a	; --------------
	ld	(ix+0eeh),a	; ----------------
	ld	(ix+0efh),a	; zf-
	ld	(ix+0f0h),a	; quell-
	ld	(ix+0f7h),a	; register
	ld	(ix+0f8h),a	; loeschen
	ld	(ix+0f9h),a	; ----------------
	ld	ix,mbytes	; gst ix-reg.
	ret
;
hts:	ld	a,(ix+2ah)	; H-TAB setzen
	cp	0dfh
	jr	z,m1307		; 16 tabm gesetzt, keine weiteren moeglich
	ld	iy,(m2c7a)	; akt.tabmr.
	ld	a,(ix+0fh)	; tabm.
	ld	(iy),a		; setzen
	inc	iy		; tabm-reg.inc
	inc	(ix+2ah)	; zhts akt.
	jr	befe0
;
m12ee:	ld	iy,tabmr	; htl:tabmr-gst
	ld	(ix+2ah),0d0h	; zhts-gst
	ld	a,16
m12f8:	ld	(iy),0		; alle 16
	inc	iy		; tabmr
	dec	a		; loeschen
	jr	nz,m12f8
	ld	iy,tabmr	; tabmr-gst
	jr	befe0
;
m1307:	set	0,(ix+0ah)	; bfab in zmr
befe0:	pop	de
	bit	6,(ix+7)
	jp	nz,hp04		; mb test=1
	in	a,(p3bd)
	bit	0,a		; ser/par
	jr	z,m1326		; ifss=1
	ld	a,(ix+0ah)
	out	(p3ad),a
	and	0e2h		; maskiert
	ld	(ix+0ah),a	; loeschen
	ei
	reti
;
m1326:	in	a,(p2bd)
	bit	6,a		; ifg
	jp	z,hp04		; ifg=0
	jp	m0cf6		; ifg=1
;
m1330:	bit	1,(ix+1)	; up lzbd
	jr	z,m1347		; mb bdrf=0
	bit	7,(ix+3)
	jr	nz,m1347	; mb bdrhp=1
	inc	hl		; sazf+1
	ld	m,8ch		; bu in zsp
	set	7,(ix+3)	; mb bdrhp1=1
	set	6,(ix+3)	; mb bdrhp2=1
m1347:	bit	4,(ix+4)	; beginn up lz
	jr	nz,m1387	; mb zspf2=1
	bit	7,(ix+1)
	jr	z,m1371		; mb at1=0
	bit	2,(ix+2)
	jr	nz,m1371	; mb sp=1
	set	2,(ix+2)	; mb sp=1
	bit	2,(ix+1)
	ld	a,(ix+0fh)	; dpz in akku
	jr	nz,m1383	; mb sdrf=1
	add	a,7		; dpz+7
m1368:	ld	(ix+16h),a	; in kpet1-reg.
m136b:	ld	(ix+22h),l	; sazf
	ld	(ix+23h),h	; in spalz
m1371:	call	m13ab		; up fo
	bit	2,(ix+4)
	ret	nz		; mb fof=1
	inc	(ix+0dh)	; lsz+1
	inc	hl		; sazf+1
	ld	m,20h		; lz in zsp
	inc	(ix+0fh)	; dpz+1
	ret
;
m1383:	add	a,8		; et1 fuer sdr
	jr	m1368
;
m1387:	bit	6,(ix+1)
	jr	z,m1371		; mb at2=0
	bit	2,(ix+2)
	jr	nz,m1371	; mb sp=1
