
	title	Programm fuer robotron 1157 Drucker 
	subttl	 Copyright (c) 1984-1986 by JDE
;
; Jonny Jonas mme Hue13
; Version 1.00      10-Sep-84
; letzte Aenderung: 24-Apr-86
;
; Programm hat folgende Aenderungen:
; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
; Automatisch vereinbarte modulo 8 TAB's fuer die ersten 132 Zeichen .
; Uebergehen von Fehlerzustaenden, die durch falsche ESC-Sequenzen oder
; andere Bedienfehler hervorgerufen wurden.
;
; Vereinbarungen:
; ~~~~~~~~~~~~~~~
;
dc1	equ	11h
dc3	equ	13h
dc4	equ	11h		; in DC1 geaendert
esc	equ	1bh
;
; I/O Adressen
; ~~~~~~~~~~~~
;
v24d	equ	7ch		; sio daten a v24
ifssd	equ	v24d+1		; sio daten b ifss
v24c	equ	v24d+2		; sio contr a v24
ifssc	equ	v24d+3		; sio contr b ifss
;
ctc0	equ	0dch		; ctc kanal 0 baudrate sio
ctc1	equ	ctc0+1		; ctc kanal 1
ctc2	equ	ctc0+2		; ctc kanal 2
ctc3	equ	ctc0+3		; ctc kanal 3
;
p1ad	equ	0f4h		; pio1 daten a
p1bd	equ	p1ad+1		; pio1 daten b
p1ac	equ	p1ad+2		; pio1 contr a
p1bc	equ	p1ad+3		; pio1 contr b
;
p2ad	equ	0f8h		; pio2 daten a
p2bd	equ	p2ad+1		; pio2 daten b
p2ac	equ	p2ad+2		; pio2 contr a
p2bc	equ	p2ad+3		; pio2 contr b
;
p3ad	equ	0ech		; pio3 daten a
p3bd	equ	p3ad+1		; pio3 daten b
p3ac	equ	p3ad+2		; pio3 contr a
p3bc	equ	p3ad+3		; pio3 contr b
;
nad18	equ	0beh		; Nadelimpule Nadel 1-8
nad9	equ	0bfh		; Nadelimpule Nadel 9
;
	if1
	.printx	-PASS1-
	else
	.printx	-PASS2-
	endif
;
; Memory Adressen
; ~~~~~~~~~~~~~~~
;
ram1	equ	2c00h		; 1k byte system
stack	equ	ram1+28h
m2c3c	equ	ram1+3ch	; 2
m2c3e	equ	ram1+3eh	; 6
m2c44	equ	ram1+44h	; 3
m2c47	equ	ram1+47h	; 6
m2c4d	equ	ram1+4dh	; 3
mbytes	equ	ram1+50h	; 32	
m2c71	equ	ram1+71h	; 9
m2c7a	equ	ram1+7ah	; 4
ipzf	equ	ram1+7eh	; 2
ipzl	equ	ram1+80h	; 13
flenl	equ	ram1+8dh	; 33
flenr	equ	ram1+0aeh	; 6
m2cb4	equ	ram1+0b4h	; 16
m2cc4	equ	ram1+0c4h	; 2
m2cc6	equ	ram1+0c6h	; 2
m2cc8	equ	ram1+0c8h	; 8
tabmr	equ	ram1+0d0h	; 16
;				  Interrupt Adressen
isa00	equ	ram1+0e0h	; ctc kanal 0 unbenutzt
isa02	equ	ram1+0e2h	; ctc kanal 1
isa04	equ	ram1+0e4h	; ctc kanal 2
isa06	equ	ram1+0e6h	; ctc kanal 3
isa08	equ	ram1+0e8h	; 
isa0a	equ	ram1+0eah	; 
isa0c	equ	ram1+0ech	; 
isa0e	equ	ram1+0eeh	; 
isa10	equ	ram1+0f0h	; sio-ifss sender leer
isa12	equ	ram1+0f2h	; sio-ifss ext-stat. (unbenutzt)
isa14	equ	ram1+0f4h	; sio-ifss empfaenger
isa16	equ	ram1+0f6h	; sio-ifss error
isa18	equ	ram1+0f8h	; sio-v24 sender leer
isa1a	equ	ram1+0fah	; sio-v24 ext-stat.
isa1c	equ	ram1+0fch	; sio-v24 empfaenger, parallel-ss
isa1e	equ	ram1+0feh	; sio-v24 error, parallel-ss
;
m2d00	equ	ram1+100h	; 9
zspei1	equ	ram1+109h	; 2e7fh-2d09h
zspei2	equ	ram1+27fh	; 2fffh-2e7fh
;
azg1	equ	3000h		; anfang zeicheng. 1
azg2	equ	3400h		; anfang zeicheng. 2
ezg2	equ	azg2+1023
konst1	equ	azg1+300h	; ausschrift im testmodus
m335f	equ	azg1+35fh
m3363	equ	azg1+363h
m3366	equ	azg1+366h
m336a	equ	azg1+36ah
siobuf	equ	3800h
siolen	equ	1024
;
	.z80
	aseg
	org	100h
	.phase	0
	page
;
; Initialisieren RAM und I/O Ports
;
sy00:	im	2
	ld	a,2ch		; Interrupt Vector
	ld	i,a
	jr	sy01
;
rst8:	ds	3,0ffh
;
sy01:	ld	sp,stack
	jr	sy02
;
rst10:	ds	3,0ffh
;
sy02:	ld	ix,mbytes	; initialisieren sys ctc, sys pio's
	ld	a,0e0h		; interruptvector fuer
	out	(ctc0),a
	ld	a,17h		; kein int,zeitg,/16,pos fla,selbst,+zk,reset
	jp	sy03
;
rst20:	ds	3,0ffh
;
; PIO's und CTC's initialisieren
;
sy03:	out	(ctc0),a
	ld	a,0cfh
	out	(p2ac),a
	ld	a,29h
	out	(p2ac),a
	ld	a,0b7h
	out	(p2ac),a
	ld	a,0feh		; Int. Vector
	out	(p2ac),a
	ld	a,0e8h
	out	(p2ac),a
	ld	a,0cfh
	out	(p2bc),a
	ld	a,1
	out	(p2bc),a
	ld	a,0b7h
	out	(p2bc),a
	ld	a,0feh
	out	(p2bc),a
	ld	a,0eah
	out	(p2bc),a
	ld	a,0cfh
	out	(p1ac),a
	ld	a,30h
	out	(p1ac),a
	ld	a,97h
	out	(p1ac),a
	ld	a,0cfh
	out	(p1ac),a
	ld	a,0ech
	out	(p1ac),a
	ld	a,0cfh
	jp	sy040
;
nmic:	jp	nmi		; bei farbbandhavarie + spannungsausfall
;
sy040:	out	(p1bc),a
	ld	a,31h
	out	(p1bc),a
	ld	a,97h
	out	(p1bc),a
	ld	a,0cfh
	out	(p1bc),a
	ld	a,0eeh
	out	(p1bc),a
	ld	a,8fh
	out	(p3ac),a
	ld	a,87h
	out	(p3ac),a
	ld	a,0fch
	out	(p3ac),a
	ld	a,0cfh
	out	(p3bc),a
	ld	a,0ffh
	out	(p3bc),a
	ld	a,87h
	out	(p3bc),a
	ld	a,0feh
	out	(p3bc),a
	in	a,(p3bd)
	bit	0,a		; ser/par
	jp	nz,sy10		; kein ser. interface
;
; SIO Interface initialisieren
;
; PIO auf Interface fuer Schalterabfrage
;
	ld	a,7		; disable interrupt
	out	(p3ac),a
	out	(p3bc),a
	ld	a,0cfh		; bit mode
	out	(p3ac),a
	ld	a,0ffh		; alles eingaenge
	out	(p3ac),a
	in	a,(p3ad)
	bit	0,a
	jp	z,sy09		; interface ifss
;
; V24 Interface initialisierung
;
	ld	b,0
	in	a,(p3ad)
	bit	4,a		; parity switch
	jr	z,sy04		; nein
	set	0,b		; parity enable bit fuer sio
	bit	3,a		; odd/even parity switch
	jr	z,sy04		; odd parity
	set	1,b		; even parity bit setzen
sy04:	bit	1,a		; stop bits 01=1
	jr	z,sy05		; 10=1 1/2
	set	2,b		; 11=2
sy05:	bit	2,a
	jr	z,sy06
	set	3,b
sy06:	set	6,b		; x16 taktrate
	ld	a,4		; sio-register 4
	out	(v24c),a
	ld	a,b		; bits fuer register 4
	out	(v24c),a
	ld	a,3		; sio-register 3
	out	(v24c),a
	in	a,(06fh)	; switch pack 3
	bit	5,a		; 7/8 bits
	jr	nz,sy08		; 8-bits
	ld	a,61h		; 7-bit,auto enable,rx enable
	out	(v24c),a
	ld	a,5		; sio-register 5
	out	(v24c),a
	ld	a,28h		; tx enable,7-bit
sy07:	out	(v24c),a
	ld	a,2		; sio-register 2
	out	(ifssc),a
	ld	a,0f0h		; interruptvector
	out	(ifssc),a
	ld	a,1		; sio-register 1
	out	(v24c),a
	ld	a,17h		; int bei jedem,int frei,veraend. vect.
	out	(v24c),a
	ld	a,1		; sio-register 1
	out	(ifssc),a
	ld	a,4		; veranderl. vector
	out	(ifssc),a
	ld	hl,isiote	; interruptvektoren v24
	ld	(isa18),hl	; senderbuffer-leer-int.
	ld	hl,serest
	ld	(isa1a),hl	; ext-status-int.
	ld	hl,serinp
	ld	(isa1c),hl	; empfaenger-int.
	ld	hl,errint
	ld	(isa1e),hl	; error-int.
	jr	sy10
;
sy08:	ld	a,0e1h
	out	(v24c),a
	ld	a,5		; sio-register 5
	out	(v24c),a
	ld	a,68h		; sendefreigabe,8-bit
	jr	sy07
;
; IFSS Interface initialisierung
;
sy09:	ld	a,4		; sio-register 4
	out	(ifssc),a
	ld	a,44h		; 1-stop,x16 taktrate
	out	(ifssc),a
	ld	a,3		; sio-register 3
	out	(ifssc),a
	ld	a,0c1h		; rx enable,8-bit
	out	(ifssc),a
	ld	a,5		; sio-register 5
	out	(ifssc),a
	ld	a,68h		; tx enable,8-bit
	out	(ifssc),a
	ld	a,2		; sio-register 2
	out	(ifssc),a
	ld	a,0f0h		; interruptvector
	out	(ifssc),a
	ld	a,1		; sio-register 1
	out	(ifssc),a
	ld	a,16h		; tx int enable,veraen.vect.,int bei jedem
	out	(ifssc),a
	ld	hl,serinp	; interruptvektoren ifss
	ld	(isa14),hl	; empfaenger-int.
	ld	hl,errint
	ld	(isa16),hl	; error-int.
	ld	hl,isiote
	ld	(isa10),hl	; senderbuffer-leer-int.
sy10:	ld	hl,ictc1	; interruptvektoren system
	ld	(isa02),hl	; sys-ctc-kanal 1
	ld	hl,ictc2a
	ld	(isa04),hl	; sys-ctc-kanal 2
	ld	hl,ictc3
	ld	(isa06),hl	; sys-ctc-kanal 3
	ld	hl,m1a0d
	ld	(isa08),hl
	ld	hl,m098d	; Interrupt linker Rand, Papiervorschub 1
	ld	(isa0c),hl
	ld	hl,m1a3d
	ld	(isa0a),hl
	ld	hl,m09ce	; Interrupt rechter Rand, Papiervorschub 2
	ld	(isa0e),hl
	in	a,(p3bd)
	bit	0,a		; ser/par
	jr	z,sy11		; ser. interface
;
; Interruptvectoren fuer PIO Interface
;
	ld	hl,iparc
	ld	(isa1c),hl
	ld	hl,ipard
	ld	(isa1e),hl
;
; Arbeitszellen und TAB's einstellen
;
sy11:	ld	(ix+27h),0
	ld	iy,tabmr
	sub	a
	ld	b,0a4h		; 00->(2c3c-2cdf)
	ld	hl,m2c3c
sy12:	ld	m,a
	inc	hl
	djnz	sy12
	ld	(ix+2bh),2ch	; tab register
	ld	(ix+2ah),low tabmr+15
	ld	hl,ttbl		; modulo 8 tabs eintragen
	ld	de,tabmr
	ld	bc,16
	ldir
	di
	ld	a,10h		; vorwaerts
	out	(p2ad),a
	ld	a,18h		; farbbandmotor ein, fehlerlampe aus
	out	(p2bd),a
	ld	a,8		; richtung fur pv1, pv2
	out	(p1bd),a
	out	(p1ad),a
	ld	(ix+3ch),52h
	ld	(ix+5dh),52h
;
; Abfrage der Formularlaengeneinstellungen
;
	ld	de,60h
	ld	b,2
	in	a,(0bch)	; 8212-system formlaenge links einstellen
	bit	4,a		; bit 4 5 laenge
	jr	z,sy13		;     0 0 4"
	inc	b		;     0 1 6"
sy13:	bit	5,a		;     1 0 8"
	jr	z,sy14		;     1 1 12"
	sla	b
sy14:	ld	hl,0
sy15:	add	hl,de
	djnz	sy15
	ld	(flenl),hl	; formlaenge links speichern
	ld	hl,0		; formlaenge rechts ermitteln
	ld	b,2
	bit	6,a		; bit 6 7 laenge
	jr	z,sy16		;     0 0 4"
	inc	b		;     0 1 6"
sy16:	bit	7,a		;     1 0 8"
	jr	z,sy17		;     1 1 12"
	sla	b
sy17:	add	hl,de
	djnz	sy17
	ld	(flenr),hl	; formlaenge rechts speichern
	ld	a,1		; kanalreset
	out	(ctc0),a
	res	7,d
	exx
	res	7,d
	exx
sy18:	ld	b,1		; baudrate (bei ifss=9600,bei v24 nach switch)
	in	a,(p3ad)
	bit	0,a
	jr	z,sy21		; IFSS Interface
;
; Baudrate fuer V24 Interface einstellen
;
	bit	5,a		; baudrate von schaltern
	jr	z,sy19
	inc	b
sy19:	bit	6,a
	jr	z,sy20
	sla	b
	sla	b
sy20:	bit	7,a
	jr	z,sy21
	sla	b
	sla	b
	sla	b
	sla	b
;
sy21:	ld	(ix+0ech),b	; baudrate zwischenspeichern
	ld	a,0b7h		; int frei,zeitgeber,:256,+zk,reset
	out	(ctc1),a
	ld	a,0ffh		; zk=255
	out	(ctc1),a
	ld	(ix+10h),0ch
	set	5,(ix+5)
sy22:	ei
	bit	5,(ix+5)
	jr	nz,sy22
sy23:	in	a,(p2bd)
	bit	3,a		; /tf
	jr	z,sy26		; techn. fehler
	bit	6,(ix+5)	; mb syn
	jr	nz,sy32		; mb syn=1
	in	a,(p2ad)
	bit	3,a		; /vk
	jr	z,sy28		; vorwarnkontakt geschl.
sy24:	in	a,(p2ad)
	res	4,a		; rueckwaerts
	out	(p2ad),a
	ld	(ix+0eh),0ffh
	jr	sy29
;
sy25:	in	a,(p2ad)
	set	6,a		; lfg=1
	out	(p2ad),a
	set	6,(ix+5)
	jp	hp04
;
sy26:	in	a,(p3bd)
	bit	1,a		; taste online
	jr	z,sy27		; offline
	di
	halt
;
sy27:	set	4,(ix+8)	; mb dc4=1
	jp	m0b93
;
sy28:	in	a,(p2ad)
	set	4,a		; vorwaerts
	out	(p2ad),a
	ld	(ix+0eh),1eh
sy29:	in	a,(p2ad)
	set	2,a		; vtab=1 tabgeschw.
	out	(p2ad),a
	bit	3,(ix+5)
	jr	nz,sy25		; mb asl=1
	di
	in	a,(p2ad)
	set	6,a		; lfg=1
	out	(p2ad),a
	in	a,(p2ad)
	res	6,a		; lfg=0
	out	(p2ad),a
	set	3,(ix+5)	; mb asl=1
sy30:	in	a,(p2ad)
	bit	5,a		; lauf
	jr	nz,sy30		; lauf=1
	jp	sy18		; lauf=0
;
sy31:	push	bc
	ld	(ix+3bh),0ah	; zeitkonstante
	call	zs00		; zeitschleife
	pop	bc
	call	hp91
	set	0,(ix+2)
	jp	hp04
;
sy32:	in	a,(p1ad)
	bit	5,a		; /lr
	jr	nz,sy24		; rand nicht erreicht
	bit	1,(ix+5)	; mb apv
	jr	nz,sy31		; mb apv=1
	bit	0,(ix+2)	; mb slz sichtbarmachen letzte zeile
	jp	z,m0b53		; mb slz=0
	in	a,(p3bd)
	bit	5,a		; zfv
	jr	nz,sy33
	bit	2,(ix+0ch)
	jp	z,m2781
	in	a,(p3bd)
	bit	7,a
	jp	nz,m2781
	ld	(ix+0ch),10h
sy33:	sub	a
	ld	(ix+0dh),a
	ld	(ix+0fh),a
	push	bc
	ld	b,5
	ld	hl,mbytes+1
sy34:	ld	m,a
	inc	hl
	djnz	sy34
	pop	bc
	in	a,(0bch)	; 8212-system
	bit	1,a		; taste 6/8 lpi
	jp	z,sy39		; 8 lpi
	set	0,(ix+34h)	; mb za61=1
	set	0,(ix+55h)	; mb za62=1
	ld	(ix+41h),4
	ld	(ix+62h),4
sy35:	ld	(ix+28h),28h
	ld	(ix+29h),32h
	exx
	ld	d,0
	exx
	in	a,(p3bd)
	bit	1,a		; taste online
	jr	nz,sy40		; offline
	in	a,(0bch)	; 8212-system
	bit	0,a		; /pe
	jr	z,sy41		; papierende
	res	7,(ix+5)	; mb off=0
	in	a,(p2ad)
	set	1,a		; a0-i=1 onlinelampe
	out	(p2ad),a
	in	a,(p2bd)
	set	7,a		; ac-i=1
	out	(p2bd),a
sy36:	in	a,(p2bd)
	set	6,a		; ifg=1
	out	(p2bd),a
	set	3,(ix+9)
	set	4,(ix+9)
sy37:	ld	(ix+8),1
	ld	(ix+0bh),0
	ld	hl,zspei1
	ld	(ix+0ah),20h
	in	a,(0bch)	; 8212-system
	bit	3,a		; bda breite ausf.
	jr	z,sy38
	set	6,(ix+0ah)
sy38:	in	a,(0bch)	; 8212-system
	bit	0,a		; /pe
	jp	nz,hp00		; kein papierende
	set	2,(ix+0ah)	; zmb pe=1
	set	2,(ix+0bh)	; mzmb pe=1
	set	4,(ix+8)	; mb dc4=1
	jp	hp00
;
sy39:	res	0,(ix+34h)
	res	0,(ix+55h)
	ld	(ix+41h),3
	ld	(ix+62h),3
	jr	sy35
;
sy40:	set	7,(ix+5)	; mb off=1
	jr	sy37
;
sy41:	set	5,(ix+7)	; mb ape=1
	jr	sy36
;
ttbl:	db	8,16,24,32	; modulo 8 Tabs fuer 132 Zeichen
	db	40,48,56,64
	db	72,80,88,96
	db	104,112,120,128
;-----------------------------------------------------------------------------
hp00:	di
	in	a,(p2ad)
	bit	6,a		; lfg
	jr	nz,hp03		; lfg=1
	bit	5,a		; lauf
	jr	nz,hp04		; lauf=1
	res	1,(ix+7)	; mb rkbl=0
	bit	3,(ix+5)	; mb asl
	jp	nz,m051a	; mb asl=1
	bit	6,(ix+3ah)	; mb pva
	jr	nz,hp04		; mb pva1=1
	bit	6,(ix+5bh)	; mb pva2
	jr	nz,hp04		; mb pva2=1
	bit	0,(ix+0ch)	; mb zfl
	jr	nz,hp04		; mb zfl=1
	bit	4,(ix+5)	; mb bkas
	jr	nz,hp04		; mb bkas=1
	in	a,(p2bd)
	bit	3,a		; /tf
	jp	z,m0b93		; technischer fehler
	bit	0,(ix+7)
	jr	z,hp02		; smrf=0
	bit	5,(ix+5)
	jr	nz,hp04		; mb kber=1
	jp	m077a		; einl. dr. n. smrf
;
hp02:	ld	a,(ix+10h)	; kberz in akku
	sub	3
	jp	p,hp04		; kberz>02
	ld	a,15h		; ctc-k0
	out	(ctc0),a
	ld	a,(ix+0ech)	; ohne abbruch starten
	out	(ctc0),a
	jp	m24b5		; abfrage pv
;
hp03:	bit	0,(ix+7)	; mb smrf
	jr	nz,hp04		; mb smrf=1
	bit	6,(ix+5)	; mb syn
	jr	nz,hp04		; mb syn=1
	bit	5,a		; lauf
	jr	z,nmi		; nmi bei lauf=0
hp04:	in	a,(p2bd)
	bit	3,a		; /tf
	jr	nz,hp05		; kein techn. fehler
	bit	1,(ix+0ah)	; zmb hv
	jr	nz,hp05		; zmb hv=1
	call	hpv1		; up hv
hp05:	ei
	jp	hp00
;
nmi:	ld	ix,mbytes	; beginn nmi-interrupt
	ld	a,7		; interruptfreigabe fuer pio 1+2 sperren
	out	(p2ac),a
	out	(p2bc),a
	out	(p1ac),a
	out	(p1bc),a
	ld	sp,stack-8	; -----------
	ld	hl,nmi1		; interrupt-
	ld	(stack-8),hl	; prioritaets-
	ld	(stack-6),hl	; kette
	ld	(stack-4),hl	; inaktivieren
	ld	hl,m0450
	ld	(stack-2),hl	; -------------
nmi1:	reti
