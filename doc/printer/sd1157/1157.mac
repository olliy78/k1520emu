	bit	2,(ix+1)
	ld	a,(ix+0fh)	; dpz in akku
	jr	nz,m13a7	; mb sdrf=1
	add	a,7		; dpz+7
m13a2:	ld	(ix+17h),a	; in kpet2-reg.
	jr	m136b
;
m13a7:	add	a,8		; et2 fuer sdr
	jr	m13a2
;
m13ab:	in	a,(0bch)	; 8212-system beginn up fo
	bit	3,a		; breite ausf.
	jr	nz,m13ee	; bda=1
	bit	1,(ix+1)	; mb bdrf
	jr	nz,m13cb	; mb bdrf=1
	bit	2,(ix+1)	; mb sdrf
	jr	nz,m13cb	; mb sdrf=1
	ld	a,(ix+0fh)	; dpz druckpositionszaehler
	cp	84h
	jr	nc,m13e1	; >131 zeichen
m13c4:	bit	2,(ix+4)
	jr	nz,m13e5	; mb fof=1
	ret
;
m13cb:	bit	7,(ix+0fh)	; druckpositionszaehler
	jr	z,m13c4		; dpz<128
	in	a,(0bch)	; 8212-system
	bit	3,a		; breite ausf.
	ld	a,(ix+0fh)	; druckpositionsz. in akku
	res	7,a		; pos. 0-127
	jr	nz,m13ea	; bda=1
	cp	3
