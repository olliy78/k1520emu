2C7C  21 AD 01      	LD HL,01ADH
2C7F  CB 96         	RES 2,(HL)
2C81  CB 9E         	RES 3,(HL)
2C83  2A B2 01      	LD HL,(01B2H)
2C86  CB 86         	RES 0,(HL)
