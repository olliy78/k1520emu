RST28:
0028  C3 D2 14      	JP 14D2H		;RST 28H, Ziel 14D2H (Prozess-/Aufgabenstart? [?])
REL_JMP:
002B  E3            	EX (SP),HL		;CALL 002BH mit DE = n: Sprung nach (Rueckkehradresse + DE) - relativer JP, kein Ruecksprung
002C  19            	ADD HL,DE
002D  E3            	EX (SP),HL
002E  C9            	RET
002F                	DB	00H
RST30_LEER:
