; ==========================================================================
; bs620.mac - BS620 (BS600-Betriebssystem fuer PRG 710-1), Datei "BS620" der Diskette BS600.hfe
; ==========================================================================
; Entwurf 48, AP-B0.  Erzeugt mit
;   python3 -I tools/z80_disasm2.py --format mac --no-folge --adr \
;       --karte tools/bs600/bs620.karte bs620.bin
; Eingabe bs620.bin = die 104 Sektoren (26624 B) der Datei BS620 (Spur 6 Sektor 15 bis
; Spur 13 Sektor 13), erzeugbar mit tools/bs600/dump_sektoren.py (flacher Abzug) + tools/bs600/analyse_dateisystem.py (Dateien auslesen).
; Die Aufteilung in Code und Daten ist Heuristik (Rekursion aus den Einstiegen der Karte); ob eine
; Stelle als Code oder Daten gefuehrt wird, darf falsch sein.  Nicht gegen einen Assembler geprueft.
;
; LADEPLAN (Befund AP-B0, [Disk]):
;   Datei-Offset 0000-42FF  -> 6D00-AFFF   Programm und Tabellen ("Ueberlagerungsbereich", bleibt dort)
;   Datei-Offset 4300-4EFF  -> B000-BBFF   Quellkopie des Monitors; START (6D5F) kopiert sie nach 0000-0BFF
;   Datei-Offset 4F00-67FF  -> BC00-D4FF   Quellkopie; START kopiert sie nach 1000-28FF
; Die Listung unten zeigt die Segmente unter ihren LAUFZEITADRESSEN (6D00, 0000, 1000); die Quellkopie
; B000-D4FF steht nicht doppelt.  Ausnahme: D400-D4FF wird in Stufe 1 AUCH am Ladeort ausgefuehrt
; (Fehlerausgabe des Selbsttests, JP D400 usw.); dieselben Bytes stehen als 2800-28FF im Segment 1000.
; Die Marken ZTD4xx (EQU) bezeichnen diese Ladeort-Adressen.
;
; Monitor-Sprungleiste 0B90-0BFF: JP-Tabelle der Konsolen- und Dateidienste (CALL 0BA0 usw.).
; Sprungleiste AF60-AFFF: JP-Tabelle des Ueberlagerungsbereichs (6D00-AFFF).
; E/A-Zugriffe ohne feste Portzahl (OUT (C),r) sind im Text nur an den LD C,nn erkennbar.
; ==========================================================================
	.Z80
	CSEG

; N Fuellbytes FFH (UDOS-Segmente haben unbenutzte Luecken)
FILLFF	MACRO	N
	REPT	N
	DB	0FFH
	ENDM
	ENDM

ZTD400	EQU	0D400H
ZTD40C	EQU	0D40CH
ZTD41F	EQU	0D41FH
ZTD431	EQU	0D431H
ZTD436	EQU	0D436H
ZTD442	EQU	0D442H
ZTD44B	EQU	0D44BH
ZTD452	EQU	0D452H
ZTD458	EQU	0D458H
ZTD45E	EQU	0D45EH
ZTD464	EQU	0D464H
ZTD46D	EQU	0D46DH
ZTD484	EQU	0D484H
ZTD488	EQU	0D488H
ZTD48A	EQU	0D48AH

; ---- Segment 6D00H .. AFFFH ----
	.PHASE	6D00H
SEG6D00:
	DB	38H,6FH,38H,6FH,38H,6FH,38H,6FH
L6D08:
	DB	00H,0B7H
L6D0A:
	DB	27H,00H
L6D0C:
	DB	57H
L6D0D:
	DB	1FH
L6D0E:
	DB	55H,01H
L6D10:
	DB	00H,18H,04H,4FH,05H,68H,01H,00H,03H,0C1H,86H,02H,0CFH,00H,02H,0CFH
	DB	00H
L6D21:
	DB	0FH
	DB	'RAM-ZELLE '
L6D2C:
	DB	'     '
L6D31:
	DB	'PIO ZE PORTCTC ZE KANALCTC ATP KANALSIO  KANAL'
; ===== Stufe 0: Speicherverwaltung und RAM-Test A (vor jeder Bildausgabe, Fehler fatal) =====
; E8H[0] := 00 (Seite 0 = RAM), E8H[F] := FF (VRAM sichtbar).  [Disk]
START:
	XOR A	; 6D5F
	LD B,A	; 6D60
	LD C,0E8H	; 6D61
	OUT (C),A	; 6D63
	LD A,0FFH	; 6D65
	LD B,0F0H	; 6D67
	OUT (C),A	; 6D69
	LD A,0AAH	; 6D6B
; RAM-Test A: Muster AAH dann 55H; fuellen 0000-0BFF und 1000-28FF, dann 10 Lesedurchlaeufe (CPI).
L6D6D:
	LD HL,L0000	; 6D6D
	LD (HL),A	; 6D70
	LD DE,0001H	; 6D71
	LD BC,0BFFH	; 6D74
	LDIR	; 6D77
	LD HL,L1000	; 6D79
	LD (HL),A	; 6D7C
	LD DE,L1001	; 6D7D
	LD BC,18FFH	; 6D80
	LDIR	; 6D83
	LD D,0AH	; 6D85
L6D87:
	LD HL,L0000	; 6D87
	LD BC,0C00H	; 6D8A
L6D8D:
	CPI	; 6D8D
	JR NZ,RAM_A_FEHLER	; 6D8F
	JP PE,L6D8D	; 6D91
	LD HL,L1000	; 6D94
	LD BC,1900H	; 6D97
L6D9A:
	CPI	; 6D9A
	JR NZ,RAM_A_FEHLER	; 6D9C
	JP PE,L6D9A	; 6D9E
	DEC D	; 6DA1
	JR NZ,L6D87	; 6DA2
	RRA	; 6DA4
	JR NC,L6D6D	; 6DA5
	JR RAM_A_FERTIG_KOPIE	; 6DA7
; Fehler: E8H[0] := FF (ZRE-ROM sichtbar), E8H[F] := 00; HL-1 = fehlerhafte Zelle als 4 Hexziffern in den Text 'RAM-ZELLE xxxx ' (6D2C), Ausgabe ueber CALL 04BC, dann (0FDA):=11H und RST 38.  04BC/0038 gehoeren zum 3-KB-ROM des PRG700 (Debugger 'mit Ruecksprung'); im 1-KB-ROM des 710/710-1 liegt dort nichts Passendes (0400-0BFF unbestueckt = FFH) [?].  Kein F4H/F5H-Code.
RAM_A_FEHLER:
	XOR A	; 6DA9
	LD B,A	; 6DAA
	DEC A	; 6DAB
	LD C,0E8H	; 6DAC
	OUT (C),A	; 6DAE
	INC A	; 6DB0
	LD B,0F0H	; 6DB1
	OUT (C),A	; 6DB3
	LD DE,L6D2C	; 6DB5
	LD (0E80H),HL	; 6DB8
	JR L6DCA	; 6DBB
HEXZIFFER:
	CP 0AH	; 6DBD
	JR NC,L6DC6	; 6DBF
	ADD A,30H	; 6DC1
L6DC3:
	LD (DE),A	; 6DC3
	INC DE	; 6DC4
	RET	; 6DC5
L6DC6:
	ADD A,37H	; 6DC6
	JR L6DC3	; 6DC8
L6DCA:
	DEC HL	; 6DCA
	LD A,H	; 6DCB
	AND 0F0H	; 6DCC
	RRCA	; 6DCE
	RRCA	; 6DCF
	RRCA	; 6DD0
	RRCA	; 6DD1
	CALL HEXZIFFER	; 6DD2
	LD A,H	; 6DD5
	AND 0FH	; 6DD6
	CALL HEXZIFFER	; 6DD8
	LD A,L	; 6DDB
	AND 0F0H	; 6DDC
	RRCA	; 6DDE
	RRCA	; 6DDF
	RRCA	; 6DE0
	RRCA	; 6DE1
	CALL HEXZIFFER	; 6DE2
	LD A,L	; 6DE5
	AND 0FH	; 6DE6
	CALL HEXZIFFER	; 6DE8
	LD HL,L6D21	; 6DEB
	CALL L04BC	; 6DEE
	LD A,11H	; 6DF1
	LD (0FDAH),A	; 6DF3
	RST 38H	; 6DF6
; ===== Stufe 1: Resident nach unten kopieren, Seiten umschalten, Bild loeschen =====
; B000-BBFF nach 0000-0BFF, BC00-D4FF nach 1000-28FF.  Danach laeuft der Monitor aus dem unteren RAM; D400-D4FF bleibt zusaetzlich am Ladeort (Stufe-1-Fehlerroutinen, ZTD4xx).
RAM_A_FERTIG_KOPIE:
	LD HL,0B000H	; 6DF7
	LD DE,L0000	; 6DFA
	LD BC,0C00H	; 6DFD
	LDIR	; 6E00
	LD DE,L1000	; 6E02
	LD BC,1900H	; 6E05
	LDIR	; 6E08
; E8H[1,7,8,9,A] := 04.  Bedeutung des Wertes 04 unbekannt [?] (vermutlich Schreibschutz der Seite); der Emulator behandelt ein unteres Halbbyte <> 0 als 'Systemkarte' = leer -> BS620 wuerde hier die Seiten 1 und 7-A verlieren (Befund AP-B0).
	LD C,0E8H	; 6E0A
	LD B,10H	; 6E0C
	LD A,04H	; 6E0E
	OUT (C),A	; 6E10
	LD B,70H	; 6E12
	OUT (C),A	; 6E14
	LD B,80H	; 6E16
	OUT (C),A	; 6E18
	LD B,90H	; 6E1A
	OUT (C),A	; 6E1C
	LD B,0A0H	; 6E1E
	OUT (C),A	; 6E20
; Bild loeschen: F800-FFFF := 20H (VRAM); (03FE) = Endadresse/Kennung F7FC bzw. FCF7 je nach Rueckleseprobe (F7FF=20H?) [?]
	LD HL,0FFFFH	; 6E22
	NOP	; 6E25
	LD (HL),20H	; 6E26
	LD DE,0FFFEH	; 6E28
	LD BC,07FFH	; 6E2B
	LDDR	; 6E2E
	NOP	; 6E30
	LD A,20H	; 6E31
	CP (HL)	; 6E33
	LD L,0FCH	; 6E34
	JR Z,L6E3B	; 6E36
	LD L,H	; 6E38
	LD H,0FCH	; 6E39
L6E3B:
	LD (L03FE),HL	; 6E3B
	XOR A	; 6E3E
	LD (0E50H),A	; 6E3F
; SP := 2900; Fehlermerker (0E50) := 0; Titel 'GRUNDDIAGNOSE' (14 Zeichen bei 74F2, Ausgabe 13 Zeichen, Position 1DH) ueber 0BA3.
	LD SP,2900H	; 6E42
	CALL BILD_LOESCHEN	; 6E45
	CALL TEXT_INLINE	; 6E48
	DEC C	; 6E4B
	DEC E	; 6E4C
	JP P,0CD74H	; 6E4D
	LD D,D	; 6E50
	CALL NC,L1A21	; 6E51
	LD L,L	; 6E54
	LD C,(HL)	; 6E55
	INC HL	; 6E56
	LD B,(HL)	; 6E57
	INC HL	; 6E58
	OTIR	; 6E59
	INC C	; 6E5B
	LD B,(HL)	; 6E5C
	INC HL	; 6E5D
	OTIR	; 6E5E
	LD C,84H	; 6E60
	CALL PIO_PRUEFUNG	; 6E62
	LD C,85H	; 6E65
	CALL PIO_PRUEFUNG	; 6E67
	JR RAM_B_TEST	; 6E6A
PIO_PRUEFUNG:
	LD B,0AH	; 6E6C
L6E6E:
	LD A,0AAH	; 6E6E
L6E70:
	LD D,A	; 6E70
	OUT (C),A	; 6E71
	IN A,(C)	; 6E73
	CP D	; 6E75
	JP NZ,ZTD400	; 6E76
	RRA	; 6E79
	JR NC,L6E70	; 6E7A
	DJNZ L6E6E	; 6E7C
	XOR A	; 6E7E
	OUT (C),A	; 6E7F
	RET	; 6E81
; ===== Test 3: RAM B (0C00-0D8F, 2900-5FFF, B000-D3FF, D500-EFFF), Muster AAH/55H, je 2 Lesedurchlaeufe; Fehler -> 'RAM-ZELLE xxxx' + Warten auf CL/ESC, dann Abbruch dieses Tests =====
RAM_B_TEST:
	LD A,0AAH	; 6E82
L6E84:
	LD HL,0C00H	; 6E84
	LD (HL),A	; 6E87
	LD DE,0C01H	; 6E88
	LD BC,L018F	; 6E8B
	LDIR	; 6E8E
	LD HL,2900H	; 6E90
	LD (HL),A	; 6E93
	LD DE,2901H	; 6E94
	LD BC,36FFH	; 6E97
	LDIR	; 6E9A
	LD HL,0B000H	; 6E9C
	LD (HL),A	; 6E9F
	LD DE,0B001H	; 6EA0
	LD BC,L23FF	; 6EA3
	LDIR	; 6EA6
	LD HL,0D500H	; 6EA8
	LD (HL),A	; 6EAB
	LD DE,0D501H	; 6EAC
	LD BC,L1AFF	; 6EAF
	LDIR	; 6EB2
	LD D,02H	; 6EB4
L6EB6:
	LD HL,0C00H	; 6EB6
	LD BC,0190H	; 6EB9
L6EBC:
	CPI	; 6EBC
	CALL NZ,ZTD40C	; 6EBE
	JP PE,L6EBC	; 6EC1
	LD HL,2900H	; 6EC4
	LD BC,3700H	; 6EC7
L6ECA:
	CPI	; 6ECA
	CALL NZ,ZTD40C	; 6ECC
	JP PE,L6ECA	; 6ECF
	LD HL,0B000H	; 6ED2
	LD BC,L2400	; 6ED5
L6ED8:
	CPI	; 6ED8
	CALL NZ,ZTD40C	; 6EDA
	JP PE,L6ED8	; 6EDD
	LD HL,0D500H	; 6EE0
	LD BC,1B00H	; 6EE3
L6EE6:
	CPI	; 6EE6
	CALL NZ,ZTD40C	; 6EE8
	JP PE,L6EE6	; 6EEB
	DEC D	; 6EEE
	JR NZ,L6EB6	; 6EEF
	RRA	; 6EF1
	JR NC,L6E84	; 6EF2
; ===== Test 4: CTC ZE (Ports 80H-83H): Zeitgeber 27H x 256 = 9984 Takte, Interruptbetrieb IM 2, I = 6DH (Vektoren 6D00-6D06 -> 6F38) =====
CTC_ZE_TEST:
	DI	; 6EF4
	LD A,6DH	; 6EF5
	LD I,A	; 6EF7
	IM 2	; 6EF9
	LD HL,L6D08	; 6EFB
	LD B,02H	; 6EFE
	LD C,80H	; 6F00
	LD D,04H	; 6F02
L6F04:
	OTIR	; 6F04
	INC C	; 6F06
	LD B,02H	; 6F07
	DEC HL	; 6F09
	DEC HL	; 6F0A
	DEC D	; 6F0B
	JR NZ,L6F04	; 6F0C
	LD IX,CTC_ZE_KANAL_SCHLEIFE	; 6F0E
	LD D,05H	; 6F12
	LD B,01H	; 6F14
	LD C,80H	; 6F16
; je Kanal: Zeitkonstante (6D0AH = 27H) ausgeben, EI, Wartezeit ~10300 Takte; kommt der Interrupt (ISR 6F38 setzt Kanal zurueck, naechster Kanal) -> gut, sonst Fehler 'CTC ZE KANAL' F5H = 34H-D (30H..33H), F4H = 3EH.
CTC_ZE_KANAL_SCHLEIFE:
	LD A,(L6D0A)	; 6F18
	DEC D	; 6F1B
	JR Z,CTC_ATP_TEST	; 6F1C
	DI	; 6F1E
	OUT (C),A	; 6F1F
	DI	; 6F21
	EXX	; 6F22
	EI	; 6F23
	EX AF,AF'	; 6F24
	LD B,04H	; 6F25
L6F27:
	LD D,0A1H	; 6F27
L6F29:
	DEC D	; 6F29
	JR NZ,L6F29	; 6F2A
	DJNZ L6F27	; 6F2C
	DI	; 6F2E
	EXX	; 6F2F
	EX AF,AF'	; 6F30
	LD A,33H	; 6F31
	OUT (C),A	; 6F33
	JP ZTD41F	; 6F35
CTC_ZE_ISR:
	EXX	; 6F38
	EX AF,AF'	; 6F39
	LD A,33H	; 6F3A
	OUT (C),A	; 6F3C
	DJNZ L6F43	; 6F3E
	INC C	; 6F40
	LD B,01H	; 6F41
L6F43:
	INC SP	; 6F43
	INC SP	; 6F44
	PUSH IX	; 6F45
	EI	; 6F47
	RETI	; 6F48
; ===== Test 5: CTC ATP (Ports CCH, CDH): Zaehlerbetrieb, Steuerwort 57H, Zeitkonstante 1FH; sofortiges Zuruecklesen muss <> 1FH sein (CLK/TRG-Takt noetig) =====
CTC_ATP_TEST:
	LD C,0CCH	; 6F4A
	LD A,(L6D0C)	; 6F4C
	OUT (C),A	; 6F4F
	INC C	; 6F51
	OUT (C),A	; 6F52
	LD A,(L6D0D)	; 6F54
	OUT (C),A	; 6F57
	IN D,(C)	; 6F59
	CP D	; 6F5B
	CALL Z,ZTD436	; 6F5C
; (Fortsetzung Test 5: Kanal 0 (CCH) wird gleich behandelt; Fehlercode F5H = 30H fuer Kanal 0, 31H fuer Kanal 1)
	DEC C	; 6F5F
	OUT (C),A	; 6F60
	IN D,(C)	; 6F62
	CP D	; 6F64
	CALL Z,ZTD431	; 6F65
; Danach beide Kanaele auf 55H, 01H (Zaehler, Teiler 1) -- Durchreichen des CLK/TRG-Taktes an ZC/TO (Baudratentakt fuer die SIO?) [?]
	LD C,0CCH	; 6F68
	LD HL,L6D0E	; 6F6A
	LD D,02H	; 6F6D
L6F6F:
	LD B,02H	; 6F6F
	OTIR	; 6F71
	INC C	; 6F73
	LD HL,L6D0E	; 6F74
	DEC D	; 6F77
	JR NZ,L6F6F	; 6F78
; ===== Test 6: SIO (C0H Daten A, C1H Daten B, C2H Steuer A, C3H Steuer B): Init 10 Bytes (6D10), AAH senden, Empfang abwarten (~255 Abfragen), Vergleich; erst Kanal A, dann B =====
SIO_TEST:
	LD C,0C2H	; 6F7A
	LD HL,L6D10	; 6F7C
	LD B,0AH	; 6F7F
L6F81:
	OUTI	; 6F81
	JR NZ,L6F81	; 6F83
	DI	; 6F85
	LD E,0AAH	; 6F86
	LD A,E	; 6F88
	OUT (0C0H),A	; 6F89
	CALL SIO_WARTE_UND_VERGLEICH	; 6F8B
	LD C,0C3H	; 6F8E
	LD HL,L6D10	; 6F90
	LD B,0AH	; 6F93
L6F95:
	OUTI	; 6F95
	JR NZ,L6F95	; 6F97
	LD A,E	; 6F99
	OUT (0C1H),A	; 6F9A
	CALL SIO_WARTE_UND_VERGLEICH	; 6F9C
; -> HAUPTPROGRAMM (2561) ueber die Sprungleiste AFDF
	JP LAFDF	; 6F9F
SIO_WARTE_UND_VERGLEICH:
	LD B,0FFH	; 6FA2
L6FA4:
	DEC B	; 6FA4
	JR Z,L6FB4	; 6FA5
	IN A,(C)	; 6FA7
	BIT 0,A	; 6FA9
	JR Z,L6FA4	; 6FAB
	DEC C	; 6FAD
	DEC C	; 6FAE
	IN A,(C)	; 6FAF
	CP E	; 6FB1
	JR Z,L6FB7	; 6FB2
L6FB4:
	CALL ZTD442	; 6FB4
L6FB7:
	RET	; 6FB7
	DB	55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H
	DB	55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H
	DB	55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H
	DB	55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H,55H
	DB	55H
L6FF9:
	DB	55H,55H,55H,55H,55H,55H,0C9H
L7000:
	LD BC,L0003	; 7000
L7003:
	ADD IX,BC	; 7003
	PUSH IX	; 7005
	POP HL	; 7007
	INC HL	; 7008
	INC HL	; 7009
	LD A,(HL)	; 700A
	CP 80H	; 700B
	JR Z,L704A	; 700D
	LD E,01H	; 700F
L7011:
	ADD HL,BC	; 7011
	INC E	; 7012
	INC E	; 7013
	INC E	; 7014
	BIT 7,A	; 7015
	JR NZ,L7024	; 7017
	BIT 7,(HL)	; 7019
	JR NZ,L7034	; 701B
L701D:
	CP (HL)	; 701D
	JP M,L7011	; 701E
	LD A,(HL)	; 7021
	JR L7011	; 7022
L7024:
	BIT 7,(HL)	; 7024
	JR NZ,L701D	; 7026
	RES 7,A	; 7028
	CP (HL)	; 702A
	SET 7,A	; 702B
	JR Z,L7011	; 702D
	JP M,L7011	; 702F
	JR L7044	; 7032
L7034:
	SET 7,A	; 7034
	CP (HL)	; 7036
	RES 7,A	; 7037
	JP M,L7011	; 7039
	LD A,40H	; 703C
	XOR (IX+0)	; 703E
	LD (IX+0),A	; 7041
L7044:
	LD A,E	; 7044
	LD (IX+2),A	; 7045
	JR L7003	; 7048
L704A:
	PUSH HL	; 704A
	ADD HL,BC	; 704B
	POP DE	; 704C
	LDDR	; 704D
	INC HL	; 704F
	PUSH HL	; 7050
	LD C,03H	; 7051
	LD A,(HL)	; 7053
	XOR 40H	; 7054
	LD (HL),A	; 7056
	JP M,L706A	; 7057
L705A:
	LD A,04H	; 705A
	LD (IX+5),A	; 705C
	LD A,07H	; 705F
	LD (IX+2),A	; 7061
	OR (HL)	; 7064
	JP M,L706E	; 7065
	JR L707E	; 7068
L706A:
	BIT 4,A	; 706A
	JR NZ,L705A	; 706C
L706E:
	BIT 6,A	; 706E
	LD A,C	; 7070
	JR Z,L7076	; 7071
	SBC HL,BC	; 7073
	RLA	; 7075
L7076:
	INC A	; 7076
	LD (HL),8BH	; 7077
	INC HL	; 7079
	LD (HL),00H	; 707A
	INC HL	; 707C
	LD (HL),A	; 707D
L707E:
	POP HL	; 707E
	ADD HL,BC	; 707F
	RET	; 7080
	DB	0FFH
L7082:
	ADD HL,BC	; 7082
	RST 38H	; 7083
	DEC DE	; 7084
	DEC B	; 7085
	NOP	; 7086
	LD A,E	; 7087
	ADC A,H	; 7088
	NOP	; 7089
	NOP	; 708A
	LD BC,0D5E5H	; 708B
	LD C,60H	; 708E
	CALL ZEILE_LOESCHEN	; 7090
	CALL TEXT_INLINE	; 7093
	LD B,75H	; 7096
	LD C,L	; 7098
	LD (HL),D	; 7099
	LD HL,L731F	; 709A
	LD DE,L0302	; 709D
L70A0:
	LD B,D	; 70A0
	LD A,2DH	; 70A1
	ADD A,C	; 70A3
	LD C,A	; 70A4
	CALL TEXT_AUS	; 70A5
	DEC E	; 70A8
