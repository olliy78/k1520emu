# Verriegelung: nach dem ersten tar-put ist die Diskette tar720 und nur lesbar - ein
# zweites Schreiben wird mit klarer Meldung abgelehnt.
tool:   k1520disktool
tmpfile neu.img:
setup_run: create %neu.img% --fs tar720_leer
setup_run: tar-put %neu.img% %CLI_DIR%/../fixtures/p8000/tar_v7_klein.tar
run:    tar-put %neu.img% %CLI_DIR%/../fixtures/p8000/tar_v7_klein.tar
expect: nur einmal
expect: tar720
exit:   1
