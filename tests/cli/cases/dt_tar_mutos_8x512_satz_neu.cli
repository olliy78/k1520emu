# tar-satz-neu im MUTOS-Layout 8x512: eine 813-KiB-Datei braucht drei Disketten zu 608 Bloecken (311296 Byte).
tool:   k1520disktool
tmpfile m.hfe:
run:    tar-satz-neu --format tar_mutos8k_8x512_mfm %m.hfe% --put %CLI_DIR%/../fixtures/disks/cpa_cpa780_combo5zoll_noclock.img=gross.img
expect: Satz: 3 Abbild
expect: 311296 Byte je Abbild
expect: m3.hfe
expect: gespeichert: 3 Abbild
forbid: Fehler
exit:   0
