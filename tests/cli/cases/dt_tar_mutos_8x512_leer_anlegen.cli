# create --fs tar_mutos8k_8x512_mfm_leer: leere tar-Diskette im MUTOS-Layout 8x512; Zylinder 0 bleibt wie formatiert
# (26x128), der Datenbereich ab Zylinder 1 ist Null.  Die Erkennung nennt sie wieder "leer" und nicht UNIX/UDOS.
tool:   k1520disktool
tmpfile leer.hfe:
setup_run: create %leer.hfe% --fs tar_mutos8k_8x512_mfm_leer
run:    info %leer.hfe%
expect: tar_mutos8k_8x512_mfm_leer
expect: mutos_ss77
forbid: udos
forbid: Dateisystem: mutos8k
exit:   0
