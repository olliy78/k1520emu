# create --fs tar_ss77_8x512_leer: leere tar-Diskette im MUTOS-Layout 8x512; Zylinder 0 bleibt wie formatiert
# (26x128), der Datenbereich ab Zylinder 1 ist Null.  Die Erkennung nennt sie wieder "leer" und nicht UNIX/UDOS.
tool:   k1520disktool
tmpfile leer.hfe:
setup_run: create %leer.hfe% --fs tar_ss77_8x512_leer
run:    info %leer.hfe%
expect: tar_ss77_8x512_leer
expect: ss77_1t26x128-8x512
forbid: udos
forbid: Dateisystem: mutos8k
exit:   0
