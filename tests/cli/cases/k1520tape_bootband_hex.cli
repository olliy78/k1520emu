# k1520tape bootband aus Intel-HEX (JKCEMU-Format): Anfangsadresse 0400H wird verlangt, Kopf abgestreift, SYL geprueft.
tool:   k1520tape
tmpfile band.k52:
file boot.hex:
  :0404000053594C5AA6
  :00000001FF
setup_run: bootband %boot.hex% %band.k52%
run:    ls %band.k52% --side A
expect: Seite A: 4 Bloecke
expect: 132 Bytes, 128 Daten, CRC ok
exit:   0
