# create --fs tar_fm_ss77_26x128_leer: leere tar-Diskette im MUTOS-Layout (FM, 8-Zoll); Zylinder 0 bleibt wie
# formatiert, der Datenbereich ist Null.  Beim Wiederoeffnen erkennt die Erkennung sie vor UDOS.
tool:   k1520disktool
tmpfile leer.hfe:
setup_run: create %leer.hfe% --fs tar_fm_ss77_26x128_leer
run:    info %leer.hfe%
expect: tar_fm_ss77_26x128_leer
expect: fm_ss77_26x128
forbid: udos
exit:   0
