# MUTOS 8000 auf dem A5120.16 (Entwurf 39 §3a): UDOS-Ladediskette + REKONSTRUIERTE Wurzeldiskette
# (disks/a5120_16_MUTOS/a5120_mutos8000_root_fm.hfe, 26x128, Profil mutos8k_26x128_fm).
# Der Kernel (mutos_1216) liest ueber den U880-Treiber mutos_io /etc/init, startet die Anmeldung,
# `root` meldet sich an, `ls -l /` listet die Wurzel.  Ein Rueckfall in den Zustand mit M8KROOT
# (Abbild beschaedigt, Wurzel-Inode 83FE) endete bei ENOTDIR an /etc/init und zeigte nur einen Punkt.
# Beide Disketten werden von k1520dbg als Kopie (COW) gemountet — die eingecheckten Abbilder bleiben heil.
# Die Wartezeiten sind grosszuegig (Anmeldeaufforderung ca. 12 Mio. Takte nach `r`).
tool:      k1520dbg
disk_path: %CLI_DIR%/../../disks/a5120_mutos8000/a5120_mutos8000_boot_udos.dmk
timeout:   300
run:       --em em256 %DISK%
stdin:
  g 80000000
  keys BOOT\sMUTOS\r
  g 100000000
  eject A
  mount C %CLI_DIR%/../../disks/a5120_16_MUTOS/a5120_mutos8000_root_fm.hfe udos_ss77
  keys r
  g 100000000
  screen
  keys root\r
  g 100000000
  keys ls\s-l\s/\r
  g 100000000
  screen
  q
exit:      0
expect:    mem = 196608
expect_re: single user login: root\s+\|
expect:    MUTOS 8000 V.1.0
expect_re: \|# ls -l /\s+\|
expect_re: -rw-rw-r-- 1 root\s+108 Jan  9  1986 \.profile
expect_re: drwxrwxrwx 2 root\s+336 Jan  9  1986 dev
expect_re: drwxrwxrwx 2 root\s+192 Jan  9  1986 etc
forbid:    panic
forbid:    err on dev
