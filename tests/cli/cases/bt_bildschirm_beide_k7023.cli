# boot_trace --bildschirm beide --schalter k7023: Brücke Bit 6 = BAB1, CP/A startet im 16x64-Format,
# der Bildschirmbericht kommt von der K7023 (64 Spalten).
tool:    boot_trace
disk:    cpa_cpa780_k5601_noclock.hfe
run:     -L /dev/null --bildschirm beide --schalter k7023 --until "screen ~ \"A>\"" -c 80000000 -p 1 %DISK%
expect:  Bildschirm:  beide (K7024 + K7023), angezeigt: K7023 64x16
expect:  Screen (VRAM as text, 64 cols
forbid:  not met
