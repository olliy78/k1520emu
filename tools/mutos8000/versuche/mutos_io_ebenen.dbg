# mutos_io: Interrupt-Zustellung.  A8H lesen: Bit 3 = /VI (0 = Vektor steht noch an), Bits 0..2 = A33 (Ebene des Z8000).
# 9053: Kontrollblock-Abfrage (A = IN A8H), 9059: Vergleich mit IX+1;  90BE/90C0: Tastatur;  949B: Zeitgeber;
# 90A3: Fertigmeldung mit Vektor A;  90D4: Tastatur-Vektor 22H;  94AA: Zeitgeber-Vektor 02H (OUT ACH = Zaehler)
#   tools/dev.sh tool k1520dbg --em em256 --laufwerke K5601,K5601,K5601 disks/a5120_16_MUTOS/a5120_mutos8000_boot_udos_k5601.hfe -x tools/mutos8000/versuche/mutos_io_ebenen.dbg
lp 0x9051 IX [IX+0] [IX+1]
lp 0x9053 A B
lp 0x90BE A
lp 0x949B A
lp 0x94A8 A
lp 0x94AA A
lp 0x90D0 A
lp 0x90D4 A
lp 0x90A3 A
g 80000000
keys BOOT\sMUTOS\r
g 100000000
eject A
mount C disks/a5120_16_MUTOS/a5120_mutos8000_root_mfm.hfe udos_ss77
keys r
g 100000000
keys root\r
g 100000000
keys ls\s-l\s/\r
g 100000000
q
