# K1: cc/as/ld im MUTOS-Gast (Entwurf 41). Quelldiskette vorher bauen (Pfade anpassen):
#   k1520disktool create quelle.hfe --fs mutos8k_26x128_mfm --inodes 24
#   k1520disktool put quelle.hfe tools/mutos8000/kernel/probe/t2.c tools/mutos8000/kernel/probe/t3.c fertig1 fertig2 fertig3 fertig4
#   (fertigN = Textdatei mit dem Inhalt ENDEN; dient als Marke fuer gscreen, jede Marke muss neu sein)
#   tools/dev.sh tool k1520dbg --em em256 --laufwerke K5601,K5601,K5601,K5601 disks/a5120_16_MUTOS/a5120_mutos8000_boot_udos_k5601.hfe -x <dieses Skript>
# QUELLE=/pfad/quelle.hfe und DISKS=/pfad/disks/a5120_16_MUTOS unten ersetzen.
g 80000000
keys BOOT\sMUTOS\r
g 100000000
eject A
mount B DISKS/a5120_mutos8000_usr_mfm.hfe udos_ss77
mount C DISKS/a5120_mutos8000_root_mfm.hfe udos_ss77
mount D QUELLE udos_ss77
keys r
g 100000000
keys root\r
g 100000000
keys /etc/mount\s/dev/rk1\s/usr\r
g 30000000
keys /etc/mount\s/dev/rk3\s/mnt\r
keys cd\s/mnt\r
g 20000000
keys PATH=/bin:/usr/bin:.\r
g 20000000
keys cc\s-c\st2.c;cat\sfertig1\r
gscreen "ENDE1" 900000000
keys cc\s-c\st3.c;cat\sfertig2\r
gscreen "ENDE2" 1500000000
keys cc\st2.o\st3.o;cat\sfertig3\r
gscreen "ENDE3" 1500000000
keys a.out;cat\sfertig4\r
gscreen "ENDE4" 300000000
keys ls\s-l\r
g 30000000
screen
q
