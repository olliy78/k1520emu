	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
TAB_KL2:
	DW	DCB3
	DW	KONSOLE_AUS
	DW	DCB4
	DW	TTY1_AUS
	DW	DCB5
	DW	TTY2_AUS
	DW	DCB6
	DW	TTY3_AUS
	DW	DCB3
	DW	IGNORIEREN
	DW	DCB3
	DW	IGNORIEREN
	DW	DCB3
	DW	IGNORIEREN
