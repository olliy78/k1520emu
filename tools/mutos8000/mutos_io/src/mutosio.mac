	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
TAB_KL3:
	DW	DCB2
	DW	ROH
	DW	DCB2
