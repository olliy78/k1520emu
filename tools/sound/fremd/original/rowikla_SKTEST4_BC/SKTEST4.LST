00000h                                                           ;TESTPROGRAMM SOUND-K1520 mit AY-3-8910/12 und CTC
00000h                                                           ;Version für A5120/K8924 u.ä.
00000h                                                           ;-------------------------------------------------
00000h                                                           ;WERO 09/2017
00000h                                                           ;ERZEUGT CA. 1KHZ RECHTECK BEI 1,75 / 1,79 /2 MHZ AY-TAKT
00000h                                                           ;FÜR EXAKTE ODER ANDERE TONHÖHE GGF. DEN REGISTERWERT 
00000h                                                           ;"7DH" BEI HÖHE A, /B, /C VARIIEREN!
00000h                                                           ;-------------------------------------------------
00000h                                                           ;Version 1.2.0.4 für CP/A, SCPX
00000h                                                           ;KW 19.11.2017
00000h                                                           ;
00000h                                                           ;Anpassung an K1520-Soundkarte mit CTC unter NANOS EPOS 
00000h                                                           ;- Auswahl AY-Taktfrequenz
00000h                                                           ;- Test Tonausgabe, Geräusche  
00000h                                                           ;- Test parallele AY-Port(s)  Eingabe und Ausgabe
00000h                                                           ;- Test CTC  (alle Kanäle kaskadiert)
00000h                                                           ;- Test AY-SOUND über CTC-Interrupt
00000h                                                           ;   Anpassung der AYPLAY.INC an den jeweiligen Rechner notwendig!!!!
00000h                                                           ;   speziell die Adresse Interruptsäule, da I-Register bei manchen Rechner
00000h                                                           ;   nicht verändert werden darf !!!
00000h                                                           ;-------------------------------------------------
00000h                                                           ;kleine Routinen (CP/M Aufrufe) vom Heiko Poppe verwendet
00000h                                                           ;-------------------------------------------------
00000h                                                           ;ANPASSEN AN JEWEILIGES RECHNERSYSTEM:
00000h                                                           ;
00000h            AYBASE:               EQU       038H           ;BASISADRESSE AY-3
00000h            CTCBASE:              EQU       AYBASE+4       ;BASISADRESSE CTC Kanal 0
00000h                                            
00000h            START:                EQU       100H           ;PROGRAMMSTART
00000h            WORK:                 EQU       START+10H      ;BEGINN ARBEITSZELLEN (50h)
00000h            PLAYER:               EQU       WORK+50H       ;BEGINN PLAYER-ENGINE (480h)
00000h            PROGGI:               EQU       PLAYER+480H    ;PROGRAMMBEGINN
00000h            RAUS:                 EQU       0              ;RÜCKSPRUMG ZUM OS
00000h            WDH:                  EQU       WORK+2         ;WIEDERHOLUNGEN
00000h                                            
00000h            ANZ_WDH:              EQU       2              ;ANZAHL WIEDERHOLUNGEN
00000h                                            
00000h                                                           ;(ANGEGEBENE WERTE GÜLTIG FÜR CP/M)
00000h            BDOS:                 EQU       5              ;BDOS Aufruf
00000h            ESC:                  EQU       1BH
00000h            CONOUT:               EQU       02H            ;ein Zeichen ausgeben (E)
00000h            ZKOUT:                EQU       09H            ;Ausgabe Zeichenkette (DE), Ende mit $
00000h                                                           ;-------------------------------------------------
00000h                                  ORG       START          ;Anfang CP/M
00100h C3D905                           JP        START0
00103h                                                           ;0103h...0107h          ;FREI
00103h                                                           ;0108h...010Fh          ;INTERRUPTTABELLE CTC
00103h                                                           ;0108h IN INCLUDE EINTRAGEN!       
00103h                                                           ;-------------------------------------------------
00103h 0000000000                       ORG       WORK           ;ARBEITSZELLEN, BEZÜGE:
00110h                                                           ;WORK                   ;WORD, ÜBERGABE ANFANGSADESSE SONG
00110h                                                           ;WORK+2                 ;BYTE, ÜBERGABE ANZAHL ABSPIELE
00110h                                                           ;(1...255, 0 BEI SONGENDE)
00110h                                                           ;-------------------------------------------------
00110h 0000000000                       ORG       PLAYER         ;BEZÜGE:
00160h                                                           ;PLAYER+0               ;SONG LADEN+ABSPIELEN
00160h                                                           ;PLAYER+3               ;GERÄUSCH ABSPIELEN
00160h                                                           ;PLAYER+6               ;SOUND AUS
00160h                                                           ;-------------------------------------------------
00160h                                  INCLUDE   AYPBC.INC      ;AY-PLAYER-ENGINE
00160h                                                           ;#################################################
00160h                                                           ;INCLUDE-FILE "PLAYER-ENGINE"
00160h                                                           ;FÜR STC-PLAYER MIT AY-3-8910 
00160h                                                           ;Version für A5120 / K8924 u.ä.
00160h                                                           ;#################################################
00160h                                                           ;-------------------------------------------------
00160h                                                           ;ORIGINAL-VERÖFFENTLICHUNGEN:
00160h                                                           ;"MUSIK-TÜRKLINGEL MIT DEM AUDIO-COPROZESSOR AY8910"
00160h                                                           ;MAGAZIN 'RADIO', 1998/6, S. 42 + 43 (RUSSISCH)
00160h                                                           ;http://www.radioman-portal.ru/magazin/radio/1998/6.php
00160h                                                           ;
00160h                                                           ;ABSPIELROUTINE FÜR ZX81 MIT AY-3-8910-ADAPTER
00160h                                                           ;http://www.sinclairzxworld.com/viewtopic.php?t=528&start=100
00160h                                                           ;-------------------------------------------------
00160h                                                           ;PRINZIP CTC-TEIL: ENTWICKLERTEAM "M066"
00160h                                                           ;BEARBEITUNG, INCLUDE UND DOKU: WERO 10/2017
00160h                                                           ;ASSEMBLER: ASIDE
00160h                                                           ;-------------------------------------------------
00160h                                                           ;VERSION 1.1:
00160h                                                           ;* ISR GEÄNDERT
00160h                                                           ;* ARBEITSZELLEN STC-PLAYER VOR START GELÖSCHT
00160h                                                           ;* MISCHERBITS PORTREGISTER: BEI SONG-START/ENDE AUF EINGABE
00160h                                                           ;VERSION 1.2:
00160h                                                           ;* MISCHERBIST PORTREGISTER: BLEIBEN IMMER UNANGETASTET
00160h                                                           ;-------------------------------------------------
00160h                                                           ;Anpassungen an K1520-SOUND-Karte 
00160h                                                           ;Bastelsystem mit ZRE K2526 unter CP/A, SCPX 
00160h                                                           ;SOUND-CTC Interruptsäule-F7D8h I=F7h, IV=D8h
00160h                                                           ;IO-Adresse der SOUND-Karte = 38h
00160h                                                           ;SOUND-Karten CTC Kanal 0 als 20ms Zeitgeber
00160h                                                           ;Version 1.2.13
00160h                                                           ;KW 19.11.2017 (Klaus Wilfling)
00160h                                                           ;
00160h                                                           ;-------------------------------------------------
00160h                                                           ;ANFORDERUNGEN AN HAUPTPROGRAMM:
00160h                                                           ;* MUSS ARBEITSZELLENBEGINN MIT LABEL 'WORK' DEFINIEREN!
00160h                                                           ;* DARF LABELS X0001...X0087 NICHT BENUTZEN
00160h                                                           ;HARDWAREBEZÜGE-----------------------------------
00160h                                                           ;* EA-ADRESSEN ANPASSEN:
00160h                                                           ;
00160h            X0001:                EQU       #38            ;AY-BASISADRESSE  (K1520/SOUND)
00160h            X0002:                EQU       #3C            ;CTC-BASISADRESSE (K1520/SOUND)
00160h                                                           ;
00160h                                                           ;Adresse der Interruptsäule für SOUND-CTC 
00160h                                                           ;für CP/A und bei SCPX auf 0F7D8h, IM2 , I-Register F7h
00160h                                                           ;
00160h            X0003:                EQU       #F7D8          ;INTERRUPTTABELLE (K1520 -CP/A, SCPX)
00160h                                                           ;
00160h                                                           ;
00160h                                                           ; Variante 1:* CTC K0+K1 KASKADIERT UND MIT 500KHZ AN TRG0 GETAKTET
00160h                                                           ; Variante 2:* CTC K0 als Zeitgeber verwendet, Systemtakt 2,4576 MHz --> 50Hz
00160h                                                           ;* CTC-PROGRAMMIERUNG BEI BEDARF ANPASSEN!
00160h                                                           ;
00160h                                                           ;-------------------------------------------------
00160h                                                           ;PLAYER-AREBEITSZELLEN AB WORK
00160h            X0004:                EQU       WORK           ;WORD   ;WORK     ABLAGE LIEDANFANG   
00160h            X0005:                EQU       X0004+2        ;BYTE   ;WORK+#02 ABLAGE ANZAHL SONG-WIEDERHOLUNGEN 
00160h            X0006:                EQU       X0005+1        ;WORD   ;WORK+#03 POSITIONS-ZEIEGR
00160h            X0007:                EQU       X0006+2        ;WORD   ;WORK+#05 ORNAMENT-ZEIGER      
00160h            X0008:                EQU       X0007+2        ;WORD   ;WORK+#07 PATTERN-ZEIGER       
00160h            X0009:                EQU       X0008+2        ;WORD   ;WORK+#09 POINTER 1. SAMPLE NR       
00160h            X0010:                EQU       X0009+2        ;BYTE   ;WORK+#0B GLOBAL DELAY SONG  
00160h            X0011:                EQU       X0010+1        ;BYTE   ;WORK+#0C GLOBAL DELAY WORK
00160h            X0012:                EQU       X0011+1        ;BYTE   ;WORK+#0D ANZAHL  PATTERN IM SONG 
00160h            X0013:                EQU       X0012+1        ;WORD   ;WORK+#0E ADRESSE PATTERN KANAL A 
00160h            X0014:                EQU       X0013+2        ;WORD   ;WORK+#10 ADRESSE PATTERN KANAL B
00160h            X0015:                EQU       X0014+2        ;WORD   ;WORK+#12 ADRESSE PATTERN KANAL C
00160h            X0016:                EQU       X0015+2        ;BYTE   ;WORK+#14 ENDEMARKE (FF)
00160h            X0017:                EQU       X0016+1        ;WORD   ;WORK+#15
00160h                                                           ;KANAL A------------------------------------------
00160h            X0018:                EQU       X0017+2        ;BYTE   ;WORK+#17 INDEX A
00160h                                                           ;BYTE   ;WORK+#18 NOTENNNUMMER
00160h                                                           ;BYTE   ;WORK+#19 PAUSE ZWISCHEN NOTEN
00160h            X0019:                EQU       X0018+3        ;WORD   ;WORK+#1A SAMPLEADRESSE
00160h            X0020:                EQU       X0019+2        ;WORD   ;WORK+#1C ORNAMENTADRESSE
00160h            X0021:                EQU       X0020+2        ;3XBYTE ;WORK+#1E 
00160h                                                           ;KANAL B------------------------------------------
00160h            X0022:                EQU       X0021+3        ;BYTE   ;WORK+#21 INDEX B
00160h                                                           ;BYTE   ;WORK+#22 NOTENNNUMMER
00160h                                                           ;BYTE   ;WORK+#23 PAUSE ZWISCHEN NOTEN
00160h            X0023:                EQU       X0022+3        ;WORD   ;WORK+#24 SAMPLEADRESSE
00160h            X0024:                EQU       X0023+2        ;WORD   ;WORK+#26 ORNAMENTADRESSE
00160h            X0025:                EQU       X0024+2        ;3XBYTE ;WORK+#28
00160h                                                           ;KANAL C------------------------------------------
00160h            X0026:                EQU       X0025+3        ;BYTE   ;WORK+#2B INDEX C
00160h                                                           ;BYTE   ;WORK+#2C NOTENNNUMMER
00160h                                                           ;BYTE   ;WORK+#2D PAUSE ZWISCHEN NOTEN
00160h            X0027:                EQU       X0026+3        ;WORD   ;WORK+#2E SAMPLEADRESSE
00160h            X0028:                EQU       X0027+2        ;WORD   ;WORK+#30 ORNAMENTADRESSE
00160h            X0029:                EQU       X0028+2        ;3XBYTE ;WORK+#32
00160h                                                           ;-------------------------------------------------
00160h            X0030:                EQU       X0029+3        ;BYTE   ;WORK+#35 ABGESPIELTE PATTERNANZAHL
00160h            X0031:                EQU       X0030+1        ;BYTE   ;WORK+#36 AKTUELLE PATTERNNUMMER
00160h                                                           ;-------------------------------------------------
00160h                                                           ;AUSZUGEBENDER BLOCK MIT AY3-PROGRAMMIERWERTEN
00160h            X0032:                EQU       X0031+1        ;BYTE   ;WORK+#37 REG. 0=TONHÖHE KANAL A FEIN
00160h                                                           ;BYTE   ;WORK+#38 REG. 1=TONHÖHE KANAL A GROB
00160h            X0033:                EQU       X0032+2        ;BYTE   ;WORK+#39 REG. 2=TONHÖHE KANAL B FEIN
00160h                                                           ;BYTE   ;WORK+#3A REG. 3=TONHÖHE KANAL B GROB
00160h            X0034:                EQU       X0033+2        ;BYTE   ;WORK+#3B REG. 4=TONHÖHE KANAL C FEIN
00160h                                                           ;BYTE   ;WORK+#3C REG. 5=TONHÖHE KANAL C GROB
00160h            X0035:                EQU       X0034+2        ;BYTE   ;WORK+#3D REG. 6=TONHÖHE RAUSCHEN
00160h            X0036:                EQU       X0035+1        ;BYTE   ;WORK+#3E REG. 7=MISCHER             
00160h            X0037:                EQU       X0036+1        ;BYTE   ;WORK+#3F REG. 8=LAUTSTÄRKE KANAL A  
00160h            X0038:                EQU       X0037+1        ;BYTE   ;WORK+#40 REG. 9=LAUTSTÄRKE KANAL B  
00160h            X0039:                EQU       X0038+1        ;BYTE   ;WORK+#41 REG.10=LAUTSTÄRKE KANAL C  
00160h            X0040:                EQU       X0039+1        ;BYTE   ;WORK+#42 REG.11=DAUER HÜLLKURVE FEIN
00160h                                                           ;BYTE   ;WORK+#43 REG.12=DAUER HÜLLKURVE GROB    
00160h            X0041:                EQU       X0040+2        ;BYTE   ;WORK+#44 REG.13=FORM HÜLLKURVE   
00160h            X0042:                EQU       X0041+1        ;WORD   ;WORK+#45 EFFEKT1
00160h            X0043:                EQU       X0042+2        ;BYTE   ;WORK+#47 EFFEKT2
00160h                                                           ;
00160h                                                           ;LETZTE ARBEITSZELLE: WORK+#47 = 00C7 BEI BEGINN AUF 0080
00160h                                                           ;-------------------------------------------------
00160h                                                           ;PROGRAMMANFANG PROG 
00160h                                                           ;-------------------------------------------------
00160h C39401                           JP        X0048          ;CALL PROG   = SONG LADEN+ABSPIELEN
00163h C37D01                           JP        X0045          ;CALL PROG+3 = GERÄUSCH LADEN+ABSPIELEN
00166h C38201                           JP        X0046          ;CALL PROG+6 = SOUND OFF   
00169h 000000                           DEFS      3,0            ;RESERVE
0016Ch 000000                           DEFS      3,0            ;RESERVE       
0016Fh                                                           ;REGISTERWERTE FUER "ALLES AUS"-------------------
0016Fh 0000000000 X0044:                DEFB      #00,#00,#00,#00,#00,#00,#00
00176h FF00000000                       DEFB      #FF,#00,#00,#00,#00,#00,#01
0017Dh                                                           ;GERÄUSCH LADEN+ABSPIELEN-------------------------
0017Dh 2A1001     X0045:                LD        HL,(X0004)     ;TABELLE REGISTERWERTE
00180h 1807                             JR        X0047
00182h                                            
00182h                                                           ;#############################################################        
00182h                                                           ;Variante 1: UP "SOUND STOPPEN"-------------------------------
00182h                                                           ;; X0046:  ;CTC-INTERRUPT K1 AUS, GGF ANPASSEN!
00182h                                                           ;;        LD      A,#43           ;STEUERWORT (INT AUS)
00182h                                                           ;;        OUT     (X0002+1),A     ;CTC K1   
00182h                                                           ;;        
00182h                                            
00182h                                                           ;Variante 2: UP "SOUND STOPPEN"-------------------------------
00182h            X0046:                                         ;CTC-INTERRUPT K0 AUS, GGF ANPASSEN!
00182h 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
00184h D33C                             OUT       (X0002),A      ;CTC K0   
00186h 216F01                           LD        HL,X0044       ;REGISTERWERTE FUER ANHALTEN
00189h                                                           ;##############################################################
00189h                                            
00189h 114701     X0047:                LD        DE,X0032       ;
0018Ch 010E00                           LD        BC,14          ;14 REGISTERWERTE
0018Fh EDB0                             LDIR                     ;UMLADEN
00191h C3E304                           JP        X0084          ;IN AY3 SCHREIBEN
00194h                                                           ;-------------------------------------------------
00194h                                                           ;SONGDATEN LADEN, CTC PROGRAMMIEREN, STARTEN
00194h F3         X0048:                DI        
00195h 3E0A                             LD        A,#0A
00197h 325501                           LD        (X0042),A      ;STARTWERT EFFEKT1
0019Ah AF                               XOR       A
0019Bh 325701                           LD        (X0043),A      ;STARTWERT EFFEKT2 
0019Eh 3D                               DEC       A              ;FF
0019Fh 322401                           LD        (X0016),A      ;1. ENDE-WERT SETZEN!   
001A2h                                                           ;KOPFDATEN DES LIEDES AUSLESEN------------
001A2h 2A1001                           LD        HL,(X0004)     ;LIEDANFANG
001A5h 7E                               LD        A,(HL)         ;1. ZEICHEN = "GLOBAL DELAY"
001A6h 321B01                           LD        (X0010),A      ;ABLEGEN
001A9h 23                               INC       HL             ;POSITIONSZEIGER
001AAh CD8F02                           CALL      X0055          ;HOLEN =>DE
001ADh 1A                               LD        A,(DE)         ;ANZAHL PATTERN IM SONG
001AEh 13                               INC       DE             ;DE=ADR. 1. PATTERNNNUMMER
001AFh 3C                               INC       A              ;+1
001B0h 321D01                           LD        (X0012),A      ;ANZAHL PATTERN IM SONG + 1 ABLEGEN
001B3h ED531301                         LD        (X0006),DE     ;ADRESSE 1. PATTERNNUMMER
001B7h                                            
001B7h CD8F02                           CALL      X0055          ;ORNAMENTZEIGER HOLEN
001BAh ED531501                         LD        (X0007),DE     ;ABLEGEN
001BEh D5                               PUSH      DE             ;MERKEN
001BFh                                            
001BFh CD8F02                           CALL      X0055          ;PATTERNZEIGER HOLEN
001C2h ED531701                         LD        (X0008),DE     ;ABLEGEN
001C6h                                            
001C6h 211B00                           LD        HL,#001B       ;OFFSET 1. SAMPLENUMMER
001C9h CD9402                           CALL      X0056          ;+LIEDANFANG
001CCh EB                               EX        DE,HL          ;HL=ABSOLUTADRESSE RAM
001CDh 221901                           LD        (X0009),HL     ;ABLEGEN
001D0h                                            
001D0h 212401                           LD        HL,X0016       ;DORT FF,00
001D3h 221E01                           LD        (X0013),HL
001D6h                                            
001D6h 212501                           LD        HL,X0017       ;BEREICH
001D9h 112601                           LD        DE,X0017+1
001DCh 012C00                           LD        BC,#002C
001DFh 70                               LD        (HL),B         ;LÖSCHEN
001E0h EDB0                             LDIR      
001E2h E1                               POP       HL             ;AB HL=ORNAMENTZEIGER, 
001E3h                                                           ;JEDES ORNAMENT IST 33 BYTES LANG
001E3h 012100                           LD        BC,#0021       ;IN 33ER SCHRITTEN
001E6h AF                               XOR       A              ;00
001E7h CD8A02                           CALL      X0054          ;SUCHEN
001EAh 3D                               DEC       A
001EBh 322E01                           LD        (X0021),A      ;#FF = ENDE ORNAMENT SETZEN
001EEh 323801                           LD        (X0025),A      ;#FF
001F1h 324201                           LD        (X0029),A      ;#FF
001F4h 3E01                             LD        A,#01
001F6h 321C01                           LD        (X0011),A      ;STARTWERT GLOBAL DELAY WORK
001F9h 23                               INC       HL
001FAh 222C01                           LD        (X0020),HL
001FDh 223601                           LD        (X0024),HL
00200h 224001                           LD        (X0028),HL
00203h CDE304                           CALL      X0084          ;REGISTER BESCHREIBEN
00206h                                            
00206h                                                           ;;       ;#########################################
00206h                                                           ;; Variante 1:     50-HZ-INTERRUPT PER CTC ERZEUGEN:
00206h                                                           ;;       ;CTC ALS ZÄHLER PROGRAMMIEREN, 500 KHZ EINGANG
00206h                                                           ;;       ;MIN. K0+K1 KASKADIERT 500kHz/80/125 = 50Hz
00206h                                                           ;;       ;BEI BEDARF ANPASSEN!
00206h                                                           ;;       LD      HL,X0049        ;ADR. PLAYERROUTINE
00206h                                                           ;;       LD      (X0003+2),HL    ;ALS INTERRUPT-ADRESSE  K1
00206h                                                           ;;       LD      A,LO X0003      ;IV (01)C8
00206h                                                           ;;       OUT     (X0002),A       ;K0
00206h                                                           ;;       LD      A,#47           ;STEUERWORT, KEIN INT
00206h                                                           ;;       OUT     (X0002),A       ;K0   
00206h                                                           ;;       LD      A,#50           ;ZK=80
00206h                                                           ;;       OUT     (X0002),A      
00206h                                                           ;;       LD      A,#C7           ;STEUERWORT, INT!
00206h                                                           ;;       OUT     (X0002+1),A     ;K1   
00206h                                                           ;;       LD      A,#7D           ;ZK=125
00206h                                                           ;;       OUT     (X0002+1),A  
00206h                                                           ;;       ;#########################################
00206h                                                           ;;       EI                      ;SOUND ON!
00206h                                                           ;;       RET
00206h                                            
00206h                                                           ;#########################################
00206h                                                           ; Variante 2:     50-HZ-INTERRUPT PER CTC ERZEUGEN:
00206h                                                           ;CTC ALS ZEITGEBER PROGRAMMIEREN, 2,5476 MHZ SYSTEMTAKT
00206h                                                           ;NUR K0 BENUTZT, 2,5476MHz/256/192 = 50Hz
00206h                                                           ;BEI BEDARF ANPASSEN!
00206h F3                               DI        
00207h 211B02                           LD        HL,X0049       ;ADR. PLAYERROUTINE
0020Ah 22D8F7                           LD        (X0003),HL     ;ALS INTERRUPT-ADRESSE  K0
0020Dh 3ED8                             LD        A,LO X0003     ;IV (HI=F7) LO=D8
0020Fh D33C                             OUT       (X0002),A      ;K0
00211h 3EA7                             LD        A,#A7          ;STEUERWORT, MIT INT , VT 256
00213h D33C                             OUT       (X0002),A      ;K0   
00215h 3EC0                             LD        A,#C0          ;ZK=192
00217h D33C                             OUT       (X0002),A
00219h                                                           ;#########################################
00219h FB                               EI                       ;SOUND ON!
0021Ah C9                               RET       
0021Bh                                                           ;-------------------------------------------------
0021Bh                                                           ;ROUTINE WIRD ALLER 1/50 SEKUNDEN AUFGERUFEN UND 
0021Bh                                                           ;VERANLASST 1 PROGRAMMIERUNG DES AY-3-8910 
0021Bh FDE5       X0049:                PUSH      IY
0021Dh E5                               PUSH      HL
0021Eh D5                               PUSH      DE
0021Fh C5                               PUSH      BC
00220h F5                               PUSH      AF
00221h CD3602                           CALL      X0051          ;1XAY PROGRAMMIEREN
00224h 3A1201                           LD        A,(X0005)      ;WIEDERHOLUNG SONG?
00227h B7                               OR        A              ;FERTIG?
00228h 2003                             JR        NZ,X0050       ;NEIN
0022Ah CD8201                           CALL      X0046          ;JA: CTC-INTERRUPT AUS!
0022Dh F1         X0050:                POP       AF
0022Eh C1                               POP       BC
0022Fh D1                               POP       DE
00230h E1                               POP       HL
00231h FDE1                             POP       IY
00233h FB                               EI        
00234h ED4D                             RETI      
00236h                                                           ;-----------------------------------------------------
00236h 3A1C01     X0051:                LD        A,(X0011)      ;GLOBAL DELAY WORK (IN INTERRUPTS)
00239h 3D                               DEC       A              ;VERRINGERN
0023Ah 321C01                           LD        (X0011),A      ;ABLEGEN
0023Dh C21004                           JP        NZ,X0078       ;ARBEITSBEREICH FÜLLEN
00240h                                            
00240h 3A1B01                           LD        A,(X0010)      ;GLOBAL DELAY
00243h 321C01                           LD        (X0011),A      ;WORK NEU LADEN
00246h                                            
00246h FD212701                         LD        IY,X0018       ;INDEX KANAL A
0024Ah CD1B03                           CALL      X0062          ;TEST, OB ETWAS AUSZUGEBEN
0024Dh F26102                           JP        P,X0052        ;NEIN!
00250h                                            
00250h                                                           ;KANAL A VERARBEITEN----------------------
00250h 2A1E01                           LD        HL,(X0013)     ;ADRESSE PATTERN KANAL A
00253h 7E                               LD        A,(HL)
00254h 3C                               INC       A              ;WAR FF? (ENDE PATTERN)
00255h CCD102                           CALL      Z,X0060        ;JA: NÄCHSTE PATTERN-NR./-DATEN HOLEN 
00258h 2A1E01                           LD        HL,(X0013)     ;ADRESSE PATTERN KANAL A
0025Bh CD2603                           CALL      X0063          ;AUSWERTUNG PATTERNBYTE
0025Eh 221E01                           LD        (X0013),HL
00261h                                                           ;KANAL B VERARBEITEN----------------------
00261h FD213101   X0052:                LD        IY,X0022       ;INDEX KANAL B
00265h CD1B03                           CALL      X0062          ;TEST, OB ETWAS AUSZUGEBEN
00268h F27402                           JP        P,X0053        ;NEIN
0026Bh 2A2001                           LD        HL,(X0014)     ;ADRESSE PATTERN KANAL B
0026Eh CD2603                           CALL      X0063          ;AUSWERTUNG PATTERNBYTE
00271h 222001                           LD        (X0014),HL
00274h                                                           ;KANAL C VERARBEITEN----------------------
00274h FD213B01   X0053:                LD        IY,X0026       ;INDEX KANAL C
00278h CD1B03                           CALL      X0062          ;TEST, OB ETWAS AUSZUGEBEN
0027Bh F21004                           JP        P,X0078        ;ARBEITSBEREICH FÜLLEN
0027Eh 2A2201                           LD        HL,(X0015)     ;ADRESSE PATTERN KANAL C
00281h CD2603                           CALL      X0063          ;AUSWERTUNG PATTERNBYTE
00284h 222201                           LD        (X0015),HL
00287h C31004                           JP        X0078          ;ARBEITSBEREICH FÜLLEN
0028Ah                                                           ;-------------------------------------------------
0028Ah BE         X0054:                CP        (HL)           ;SUCHEN
0028Bh C8                               RET       Z
