<?xml version="1.0" encoding="utf-8"?>
<!--
  Artefaktkonfiguration fuer SignPath (https://docs.signpath.io/artifact-configuration).
  Das hochgeladene GitHub-Artefakt ist ein ZIP mit dem unsignierten Setup; signiert
  wird nur diese eine Datei (Authenticode).  In SignPath unter
  Projekt -> Artifact Configurations hinterlegen (Inhalt dieser Datei einfuegen).
  Einzelheiten und Handgriffe: doc/ci_pipeline.md "Signierter Installer".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
